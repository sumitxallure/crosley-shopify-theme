{% doc %}
  Renders reusable cart drawer markup for both initial page loads and Section Rendering API responses.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>
  <script
    type="module"
    src="{{ 'cart-recommendations.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  {% capture empty_cart_drawer_content %}
    <div
      class="cart-drawer__content cart-drawer__content--empty"
      aria-label="{{ 'accessibility.cart' | t }}"
    >
      <h3
        class="cart-drawer__empty-heading"
        id="cart-drawer-empty-heading"
      >
        {{ 'content.your_cart_is_empty' | t }}
      </h3>

      <div class="cart-drawer__items">
        {% render 'cart-products', force_empty: true, context: 'drawer' %}
      </div>
    </div>
  {% endcapture %}

  <theme-drawer
    id="cart-drawer"
    data-skip-node-update
    modal-always
    no-persist
  >
    <dialog
      ref="panel"
      class="theme-drawer__dialog cart-drawer__dialog color-custom-drawer"
      aria-labelledby="cart-drawer-heading"
    >
      <cart-drawer-component
        {% if settings.auto_open_cart_drawer and template.name != 'cart' %}
          auto-open
        {% endif %}
      >
        <template id="empty-cart-template">
          {{ empty_cart_drawer_content }}
        </template>

        <div
          class="cart-drawer__inner{% if cart.empty? %} cart-drawer--empty{% endif %}"
          data-hydration-key="cart-drawer-inner"
        >
          {% assign cart_drawer_title = 'content.cart_title' | t %}
          {% render 'theme-drawer-header',
            title: cart_drawer_title,
            drawer_id: 'cart-drawer',
            heading_id: 'cart-drawer-heading'
          %}

          {% capture cart_items_children %}
            {%- if cart.empty? -%}
              {{ empty_cart_drawer_content }}
            {%- else -%}
              <div
                class="cart-drawer__content"
                aria-label="{{ 'accessibility.cart' | t }}"
              >
                <div class="cart-drawer__items">
                  {% render 'cart-products', context: 'drawer' %}
                </div>

                {% render 'cart-drawer-recommendations' %}
              </div>

              <div class="cart-drawer__summary">
                {% render 'cart-drawer-summary' %}
              </div>
            {%- endif -%}
          {% endcapture %}
          {% render 'cart-items-component',
            children: cart_items_children,
            is_drawer: true,
            section_id: 'cart-drawer-section'
          %}
        </div>
      </cart-drawer-component>
    </dialog>
  </theme-drawer>

  {% if render_wrapper %}
    </div>
  {% endif %}
{%- endif -%}

{% stylesheet %}
  #cart-drawer {
    --theme-drawer-width: min(440px, 90vw);
  }

  cart-drawer-component {
    --cart-drawer-padding: 24px;
    --font-paragraph--line-height: 1;
    display: contents;
    color: #171f26;
    font-family: 'acumin-pro-condensed', Arial, sans-serif;
  }

  .cart-drawer__dialog {
    --theme-drawer-padding: 24px;
    border: 0;
    box-shadow: -8px 0 32px rgb(0 0 0 / 15%);
  }

  .cart-drawer__dialog::backdrop {
    background: rgb(23 31 38 / 50%);
  }

  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__inner > .cart-items-component {
    flex: 1;
    min-height: 0;
    height: auto;
  }

  .cart-drawer__content {
    display: flex;
    flex-direction: column;
    min-height: 0;
    padding: 0;
    background: #fff;
    flex-grow: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .cart-drawer__items {
    padding: 24px;
  }

  .cart-drawer__items .cart-items__table-row {
    grid-template-columns: 80px minmax(0, 1fr);
    grid-template-rows: repeat(4, min-content) 1fr;
    grid-template-areas:
      'media details'
      'media variants'
      'media unit_price'
      'media quantity'
      'error error';
    column-gap: 20px;
    padding-block-end: 24px;
    border-block-end: 1px solid #ededed;
    margin-block-end: 24px;
  }

  .cart-drawer__items .cart-items__table-row .cart-items__details {
    display: contents;
    color: #676767;
  }

  .cart-drawer__items .cart-items__product-info {
    grid-area: details;
  }

  .cart-drawer__items .cart-items__variants-wrapper {
    grid-area: variants;
    color: #676767;
    font-size: 12px;
    letter-spacing: 0.06em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .cart-drawer__items .cart-items__unit-price-wrapper {
    grid-area: unit_price;
    margin-block-start: 6px;
    color: #171f26;
    font-size: 14px;
    line-height: 1.2;
  }

  .cart-drawer__items .cart-items__price {
    display: none;
  }

  .cart-drawer__items .cart-items__title-row {
    display: block;
  }

  .cart-drawer__items .cart-items__title {
    color: #171f26;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.03em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .cart-drawer__items .cart-items__media-container {
    width: 80px;
    height: 80px;
    aspect-ratio: 1;
    align-items: center;
    justify-content: center;
    background: #f5f5f4;
  }

  .cart-drawer__items .cart-items__media-image {
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 0;
    object-fit: contain;
  }

  .cart-drawer__items .cart-items__quantity {
    grid-area: quantity;
    margin-block-start: 14px;
  }

  .cart-drawer__items .cart-items__quantity-controls {
    gap: 16px;
  }

  .cart-drawer__items .quantity-selector-wrapper {
    gap: 0;
  }

  .cart-drawer__items .quantity-selector {
    --quantity-selector-width: 94px;
    width: 94px;
    height: 38px;
    min-height: 38px;
    border: 1px solid #dadada;
    border-radius: 0;
    background: #fff;
    flex: 0 0 94px;
  }

  .cart-drawer__items .quantity-selector :is(.quantity-minus, .quantity-plus) {
    width: 32px;
    height: 38px;
    border-radius: 0;
    color: #171f26;
  }

  .cart-drawer__items .quantity-selector input[type='number'] {
    width: 30px;
    height: 100%;
    min-width: 30px;
    border-block: 0;
    border-inline: 1px solid #dadada;
    border-radius: 0;
    color: #171f26;
    font-size: clamp(11px, calc(10.49px + 0.1307vw), 13px);
  }

  .cart-drawer__items .cart-items__remove--text {
    width: auto;
    min-width: 44px;
    height: 44px;
    padding: 0;
    color: #171f26;
    font-family: inherit;
    font-size: clamp(11px, calc(10.49px + 0.1307vw), 13px);
    font-weight: 400;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cart-drawer__items .cart-items__error {
    margin-block-start: 10px;
    color: #fd2929;
  }

  .cart-drawer__items .cart-item__error {
    padding: 0;
    color: inherit;
    font-size: 11px;
    line-height: 1.5;
  }

  .cart-drawer__items .cart-item__error .svg-wrapper {
    display: none;
  }

  .cart-drawer__summary {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    gap: 8px;
    padding: 14px 24px;
    border-block-start: 1px solid #ededed;
    margin-top: auto;
    background: #fff;
  }

  .cart-drawer__tax-note {
    margin: 0 0 2px;
    color: #676767;
    font-size: 12px;
    line-height: 1.3;
  }

  .cart-drawer__checkout,
  .cart-drawer__view-cart {
    display: flex;
    width: 100%;
    height: 44px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: 0;
    font-family: inherit;
    font-size: clamp(11px, calc(10.49px + 0.1307vw), 13px);
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }

  .cart-drawer__checkout {
    border: 1px solid #383637;
    background: #383637;
    color: #fff;
    cursor: pointer;
  }

  .cart-drawer__checkout:hover {
    background: #2a2828;
  }

  .cart-drawer__checkout:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .cart-drawer__view-cart {
    border: 1px solid #171f26;
    background: #fff;
    color: #171f26;
  }

  .cart-drawer__view-cart:hover {
    background: #f5f5f4;
  }

  #cart-drawer .theme-drawer__header {
    min-height: 76px;
    padding: 16px 24px;
    border-block-end: 1px solid #ededed;
  }

  #cart-drawer .theme-drawer__title {
    margin: 0;
    color: #171f26;
    font-family: inherit;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #cart-drawer .theme-drawer__close-button {
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    color: #676767;
  }

  #cart-drawer .theme-drawer__close-button:hover:not(:active) {
    background: transparent;
  }

  #cart-drawer .theme-drawer__close-button .svg-wrapper {
    width: 18px;
    height: 18px;
  }

  .cart-drawer--empty .cart-drawer__content,
  .cart-drawer__content--empty {
    text-align: center;
    align-items: center;
    justify-content: center;
    min-height: auto;
    padding: 32px 24px;
  }

  .cart-drawer--empty .cart-drawer__items {
    padding-inline: 0;
  }

  .cart-drawer__empty-heading {
    margin: 0;
    color: #171f26;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .cart-drawer--empty .cart-items__empty-button {
    min-width: 190px;
    min-height: 44px;
    border-radius: 0;
    background: #383637;
    color: #fff;
    font-family: inherit;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    html:active-view-transition-type(empty-cart-drawer) {
      .theme-drawer__close-button {
        view-transition-name: cart-drawer-close-button;
      }
    }
  }

  :active-view-transition {
    .cart-drawer__header,
    .cart-drawer__content {
      background: transparent;
    }
  }

  @media screen and (max-width: 389px) {
    #cart-drawer {
      --theme-drawer-width: 90vw;
    }

    .cart-drawer__items,
    .cart-recommendations__section,
    .cart-drawer__summary {
      padding-inline: 20px;
    }

    .cart-drawer__items .cart-items__table-row {
      grid-template-columns: 72px minmax(0, 1fr);
      column-gap: 16px;
    }

    .cart-drawer__items .cart-items__media-container {
      width: 72px;
      height: 72px;
    }
  }
{% endstylesheet %}
