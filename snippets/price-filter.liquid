{%- doc -%}
  Renders a price filter.

  @param {object} filter - The filter object to render.
  @param {string} filter_style - The filter style, can be 'horizontal' or 'vertical'.
  @param {boolean} [should_render_clear] - Whether to render the clear button.
  @param {string} [id_prefix] - Unique prefix to avoid duplicate IDs when rendered multiple times.
  @param {boolean} [collapse_on_mobile] - Whether the vertical filter starts collapsed on mobile.

  @example
  {% render 'price-filter', filter: filter, filter_style: 'vertical', id_prefix: 'dialog' %}
{%- enddoc -%}

{%- liquid
  assign is_horizontal = false
  assign is_vertical = false
  if filter_style == 'horizontal'
    assign is_horizontal = true
  elsif filter_style == 'vertical'
    assign is_vertical = true
  endif

  assign open_price_on_mobile = is_vertical
  if collapse_on_mobile
    assign open_price_on_mobile = false
  endif
-%}
{% capture accordion_children %}
  <details
    class="facets__panel"
    {% if filter_style == 'horizontal' %}
      data-auto-close-details="desktop"
    {% endif %}
    {% if filter_style == 'vertical' %}
      open
    {% endif %}
  >
    <summary
      class="facets__summary"
      data-testid="price-filter"
    >
      <span class="facets__label">{{ filter.label }}</span>
      <facet-status-component class="facets__status">
        <template ref="moneyFormat">{{ shop.money_format }}</template>

        <span
          class="hide-when-empty"
          ref="facetStatus"
          data-currency="{{ localization.country.currency.iso_code }}"
          data-range-max="{{ filter.range_max | money_without_currency }}"
        >
          {%- if filter.min_value.value != null or filter.max_value.value != null %}
            {%- if filter.min_value.value != null and filter.max_value.value != null %}
              <bdi>{{ filter.min_value.value | money | strip_html }}–{{ filter.max_value.value | money | strip_html }}</bdi>
            {%- elsif filter.min_value.value != null -%}
              <bdi>{{ filter.min_value.value | money | strip_html }}–{{ filter.range_max | money | strip_html }}</bdi>

            {%- elsif filter.max_value.value != null -%}
              <bdi>{{ 0 | money | strip_html }}–{{ filter.max_value.value | money | strip_html }}</bdi>
            {%- endif -%}
          {%- endif -%}
        </span>
      </facet-status-component>
      <span class="svg-wrapper icon-caret icon-animated">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
    </summary>
    <floating-panel-component
      {% unless filter_style == 'vertical' %}
        data-close-on-resize
      {% endunless %}
      class="facets__panel-content details-content{% if filter_style == 'horizontal' %} color-custom-popover{% endif %}"
    >
      {% assign min_input_max_value = filter.max_value.value | default: filter.range_max %}
      {% assign max_input_min_value = filter.min_value.value | default: 0 %}

      <price-facet-component
        class="
          price-facet
          {%- if filter_style == 'horizontal' %}
            price-facet--horizontal
          {%- endif %}
        "
        id="facet-inputs-{{ filter.param_name | escape | replace: '.', '-' }}"
        data-money-format="{{ shop.money_format | strip_html }}"
        data-currency="{{ localization.country.currency.iso_code }}"
        on:change="/updatePriceFilterAndResults"
      >
        {%- liquid
          assign range_max_value = filter.range_max | divided_by: 100.0
          assign range_min_value = 0
          assign range_current_max_value = range_max_value
          if filter.min_value.value != null
            assign range_min_value = filter.min_value.value | divided_by: 100.0
          endif
          if filter.max_value.value != null
            assign range_current_max_value = filter.max_value.value | divided_by: 100.0
          endif
          assign min_position = range_min_value | divided_by: range_max_value | times: 100
          assign max_position = range_current_max_value | divided_by: range_max_value | times: 100
        -%}
        <div
          class="price-facet__range"
          style="--price-min-position: {{ min_position }}%; --price-max-position: {{ max_position }}%;"
        >
          <span class="price-facet__range-track"></span>
          <span class="price-facet__range-fill"></span>
          <input
            class="price-facet__range-input price-facet__range-input--min"
            type="range"
            min="0"
            max="{{ range_max_value }}"
            step="0.01"
            value="{{ range_min_value }}"
            ref="minRange"
            on:input="/updatePriceRange"
            aria-label="{{ 'accessibility.price_filter_low' | t }}"
          >
          <input
            class="price-facet__range-input price-facet__range-input--max"
            type="range"
            min="0"
            max="{{ range_max_value }}"
            step="0.01"
            value="{{ range_current_max_value }}"
            ref="maxRange"
            on:input="/updatePriceRange"
            aria-label="{{ 'accessibility.price_filter_high' | t }}"
          >
        </div>

        <div class="facets__inputs-wrapper facets__inputs-wrapper--row">
          <div
            class="price-facet__inputs-wrapper"
          >
            <div class="field price-facet__field">
              <input
                class="field__input price-facet__input"
                name="{{ filter.min_value.param_name }}"
                id="{{ filter.label | escape }}-GTE-{{ id_prefix }}"
                {%- if filter.min_value.value -%}
                  value="{{ filter.min_value.value | money_without_currency }}"
                {%- endif -%}
                type="text"
                inputmode="decimal"
                placeholder="0"
                data-min="0"
                data-max="{{ min_input_max_value | money_without_currency }}"
                ref="minInput"
                autocomplete="off"
                aria-label="{{ 'accessibility.price_filter_low' | t }}"
              >

              <label
                class="field__label price-facet__label"
                for="{{ filter.label | escape }}-GTE-{{ id_prefix }}"
              >
                {{ cart.currency.symbol }}
              </label>
            </div>

            <div class="price-facet__separator">{{ 'fields.separator' | t }}</div>

            <div class="field price-facet__field">
              <input
                class="field__input price-facet__input"
                name="{{ filter.max_value.param_name }}"
                id="{{ filter.label | escape }}-LTE-{{ id_prefix }}"
                {%- if filter.max_value.value -%}
                  value="{{ filter.max_value.value | money_without_currency }}"
                {%- endif -%}
                type="text"
                inputmode="decimal"
                placeholder="{{ filter.range_max | money_without_currency }}"
                data-min="{{ max_input_min_value | money_without_currency }}"
                data-max="{{ filter.range_max | money_without_currency }}"
                ref="maxInput"
                autocomplete="off"
                aria-label="{{ 'accessibility.price_filter_high' | t }}"
              >
              <label
                class="field__label price-facet__label"
                for="{{ filter.label | escape }}-LTE-{{ id_prefix }}"
              >
                {{ cart.currency.symbol }}
              </label>
            </div>
          </div>
        </div>

        <div
          class="
            price-facet__highest-price
            {%- if filter_style == 'horizontal' %}
              price-facet__highest-price--horizontal
            {%- endif %}
          "
        >
          {%- capture formatted_highest_price -%}<bdi>{{ filter.range_max | money }}</bdi>{%- endcapture -%}
          {{ 'content.price_filter_html' | t: price: formatted_highest_price }}
        </div>

        {% if filter.min_value.value != null or filter.max_value.value != null %}
          {% assign has_active_values = true %}
        {% endif %}

        {% if should_render_clear %}
          <facet-clear-component
            class="clear-filter"
            tabindex="{% if has_active_values %}0{% else %}-1{% endif %}"
            on:click="/clearFilter"
            on:keydown="/clearFilter"
          >
            <div
              class="facets__clear {% if has_active_values %}facets__clear--active{% endif %}"
              ref="clearButton"
            >
              {{- 'actions.clear' | t -}}
            </div>
          </facet-clear-component>
        {% endif %}
      </price-facet-component>
    </floating-panel-component>
  </details>
{% endcapture %}
{% render 'accordion-custom-component',
  children: accordion_children,
  class: 'facets__item',
  open: is_vertical,
  open_by_default_on_desktop: is_vertical,
  open_by_default_on_mobile: open_price_on_mobile,
  disable_animation_on_desktop: is_horizontal,
  close_with_escape: is_horizontal
%}

{% stylesheet %}
  /* Price filter */
  .price-facet {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
  }
  .price-facet--horizontal {
    min-width: 360px;
  }

  .price-facet__inputs-wrapper {
    display: flex;
    flex-direction: row;
    padding: var(--style-border-width-inputs);
    gap: calc(var(--gap-sm) + (var(--style-border-width-inputs) * 2));
  }

  .price-facet__range {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .facets--drawer .price-facet__range {
      display: block;
      position: relative;
      height: 20px;
      margin: 18px 0 11px;
    }

    .facets--drawer .price-facet__range-track,
    .facets--drawer .price-facet__range-fill {
      position: absolute;
      top: 9px;
      left: 0;
      right: 0;
      height: 2px;
    }

    .facets--drawer .price-facet__range-track {
      background: #dadada;
    }

    .facets--drawer .price-facet__range-fill {
      left: var(--price-min-position, 0%);
      right: calc(100% - var(--price-max-position, 100%));
      background: #171f26;
    }

    .facets--drawer .price-facet__range-input {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 20px;
      padding: 0;
      margin: 0;
      appearance: none;
      background: transparent;
      pointer-events: none;
    }

    .facets--drawer .price-facet__range-input::-webkit-slider-runnable-track {
      height: 2px;
      background: transparent;
    }

    .facets--drawer .price-facet__range-input::-webkit-slider-thumb {
      width: 14px;
      height: 14px;
      margin-top: -6px;
      appearance: none;
      border: 0;
      border-radius: 50%;
      background: #171f26;
      cursor: pointer;
      pointer-events: auto;
    }

    .facets--drawer .price-facet__range-input::-moz-range-track {
      height: 2px;
      background: transparent;
    }

    .facets--drawer .price-facet__range-input::-moz-range-thumb {
      width: 14px;
      height: 14px;
      border: 0;
      border-radius: 50%;
      background: #171f26;
      cursor: pointer;
      pointer-events: auto;
    }

    .facets--drawer .price-facet__inputs-wrapper {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: 12px;
      width: 100%;
      padding: 0;
    }

    .facets--drawer .facets__inputs-wrapper {
      margin: 20px 0 0;
    }

    .facets--drawer .price-facet__field,
    .facets--drawer .price-facet__input,
    .facets--drawer .price-facet__label,
    .facets--drawer .price-facet__separator {
      height: 40px;
    }

    .facets--drawer .price-facet__input {
      padding: 10px 12px 10px 28px;
      text-align: start;
    }

    .facets--drawer .price-facet__label {
      padding: 10px 12px;
    }

    .facets--drawer .price-facet__highest-price {
      display: none;
    }
  }

  @container (max-width: 199px) {
    .price-facet__inputs-wrapper {
      flex-wrap: wrap;
    }
  }

  .price-facet__input {
    width: 100%;
    text-align: end;
    padding-inline-start: calc(2.5 * var(--input-padding-x));
  }

  .price-facet__input::placeholder {
    color: var(--facets-input-label-color);
  }

  .price-facet__separator {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-paragraph--size);
  }

  .price-facet__highest-price {
    color: var(--color-foreground-muted);
    padding: var(--padding-xs) 0 var(--padding-sm);
  }

  .price-facet__highest-price--horizontal {
    padding: 0 var(--padding-md) var(--padding-xs);
  }

  .price-facet__label {
    top: 0;
    inset-inline-start: 0;
    color: var(--facets-input-label-color);
    padding: var(--input-padding-y) var(--input-padding-x);
    transform: none;
  }
{% endstylesheet %}
