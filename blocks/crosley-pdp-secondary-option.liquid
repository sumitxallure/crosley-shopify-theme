{% doc %}
  Renders the Crosley zodiac secondary option selector used by the alternate PDP.
  This is presentation content for CRSE-172; variant wiring belongs to CRSE-173.
{% enddoc %}

{% liquid
  assign product_resource = closest.product | default: product
  assign show_zodiac_selector = product_resource.metafields.custom.enable_zodiac_selector.value
  assign option_values = 'Aries,Taurus,Gemini,Cancer,Leo,Virgo,Libra,Scorpio,Sagittarius,Capricorn,Aquarius,Pisces' | split: ','
%}

{% if show_zodiac_selector %}
  <fieldset class="crosley-pdp-secondary" data-crosley-secondary-option {{ block.shopify_attributes }}>
    <legend>
      {{ block.settings.label | escape }}:
      <span data-crosley-secondary-label>{{ option_values.first }}</span>
    </legend>
  <div class="crosley-pdp-secondary__options">
    {% for option_value in option_values %}
      <label class="crosley-pdp-secondary__option">
        <input
          type="radio"
          name="crosley-secondary-{{ section.id }}"
          value="{{ option_value | escape }}"
          {% if forloop.first %}checked{% endif %}
        >
        <svg
          aria-hidden="true"
          focusable="false"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        >
          {% case option_value %}
            {% when 'Aries' %}
              <path d="M6 20V9C6 6 8 4 12 4C16 4 18 6 18 9V20"></path>
              <path d="M12 9V20"></path>
            {% when 'Taurus' %}
              <circle cx="12" cy="15" r="5.5"></circle>
              <path d="M7 10C7 5 9.5 3 12 5.5C14.5 3 17 5 17 10"></path>
            {% when 'Gemini' %}
              <path d="M5 4H19"></path>
              <path d="M5 20H19"></path>
              <path d="M9 4V20"></path>
              <path d="M15 4V20"></path>
            {% when 'Cancer' %}
              <circle cx="7.5" cy="8" r="3"></circle>
              <path d="M7.5 11C7.5 16 16.5 16 16.5 11"></path>
              <circle cx="16.5" cy="16" r="3"></circle>
            {% when 'Leo' %}
              <circle cx="9" cy="8.5" r="4"></circle>
              <path d="M9 12.5C9 19 15 15 15 19.5C15 22 18 22 18.5 19.5C19 17 16.5 16 16.5 16"></path>
            {% when 'Virgo' %}
              <path d="M5 5V16C5 19 8 19 8 16V5"></path>
              <path d="M8.5 5V16C8.5 19 11.5 19 11.5 16V5"></path>
              <path d="M12 5V17C12 20 15 21 17 19"></path>
              <circle cx="18.5" cy="18.5" r="2"></circle>
            {% when 'Libra' %}
              <path d="M4 8H8"></path>
              <path d="M16 8H20"></path>
              <path d="M5 14C5 10 8 8 12 8C16 8 19 10 19 14"></path>
              <path d="M4 20H20"></path>
            {% when 'Scorpio' %}
              <path d="M4 5V16C4 19 7 19 7 16V5"></path>
              <path d="M7.5 5V16C7.5 19 10.5 19 10.5 16V5"></path>
              <path d="M11 5V16C11 19 14 19 14 16V9"></path>
              <path d="M14 15L19 20"></path>
              <path d="M15 20H19V16"></path>
            {% when 'Sagittarius' %}
              <path d="M5 19L19 5"></path>
              <path d="M12 5H19V12"></path>
              <path d="M9 15L14 10"></path>
            {% when 'Capricorn' %}
              <path d="M5 5V13C5 17 9 17 9 13V8"></path>
              <path d="M9 8V15C9 19 13 19 15 16"></path>
              <circle cx="18" cy="17.5" r="2.5"></circle>
            {% when 'Aquarius' %}
              <path d="M3 9C5 7 7 7 9 9C11 11 13 11 15 9C17 7 19 7 21 9"></path>
              <path d="M3 16C5 14 7 14 9 16C11 18 13 18 15 16C17 14 19 14 21 16"></path>
            {% when 'Pisces' %}
              <path d="M6 4C3 8 3 16 6 20"></path>
              <path d="M18 4C21 8 21 16 18 20"></path>
              <path d="M4 12H20"></path>
          {% endcase %}
        </svg>
        <span class="visually-hidden">{{ option_value | escape }}</span>
      </label>
    {% endfor %}
  </div>
  </fieldset>
{% endif %}

{% schema %}
{
  "name": "Crosley secondary option",
  "tag": null,
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Select secondary color" }
  ],
  "presets": [{ "name": "Crosley secondary option" }]
}
{% endschema %}
