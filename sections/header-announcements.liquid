

{% liquid
  assign is_crosley_collection = false
  if template.name == 'collection'
    assign is_crosley_collection = true
  endif

  assign benefit_1 = section.settings.crosley_benefit_1
  assign benefit_2 = section.settings.crosley_benefit_2
  assign benefit_3 = section.settings.crosley_benefit_3
  assign benefit_4 = section.settings.crosley_benefit_4
  assign mobile_benefit = benefit_1 | default: benefit_2 | default: benefit_3 | default: benefit_4

  assign countdown_seconds = section.settings.crosley_countdown_days | times: 86400
  assign countdown_hours = section.settings.crosley_countdown_hours | times: 3600
  assign countdown_minutes = section.settings.crosley_countdown_minutes | times: 60
  assign countdown_seconds = countdown_seconds | plus: countdown_hours | plus: countdown_minutes | plus: section.settings.crosley_countdown_seconds
%}

{% if is_crosley_collection %}
  <script
    src="{{ 'crosley-plp-announcement.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% elsif section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% if is_crosley_collection %}
  <crosley-plp-announcement
    class="crosley-plp-announcement"
    data-countdown-seconds="{{ countdown_seconds }}"
    data-benefit-rotation-ms="{{ section.settings.crosley_mobile_rotation_speed | times: 1000 }}"
    style="--crosley-benefits-bg: {{ section.settings.crosley_benefits_background }}; --crosley-promotion-bg: {{ section.settings.crosley_promotion_background }}; --crosley-announcement-text: {{ section.settings.crosley_text_color }};"
  >
    {% if section.settings.crosley_show_benefits %}
    <aside class="crosley-plp-announcement__benefits" aria-label="Store benefits">
      <div class="crosley-plp-announcement__benefits-desktop">
        {% if benefit_1 != blank %}
          <span data-benefit>{{ benefit_1 | escape }}</span>
          {% if benefit_2 != blank or benefit_3 != blank or benefit_4 != blank %}<span class="crosley-plp-announcement__separator" aria-hidden="true">|</span>{% endif %}
        {% endif %}
        {% if benefit_2 != blank %}
          <span data-benefit>{{ benefit_2 | escape }}</span>
          {% if benefit_3 != blank or benefit_4 != blank %}<span class="crosley-plp-announcement__separator" aria-hidden="true">|</span>{% endif %}
        {% endif %}
        {% if benefit_3 != blank %}
          <span data-benefit>{{ benefit_3 | escape }}</span>
          {% if benefit_4 != blank %}<span class="crosley-plp-announcement__separator" aria-hidden="true">|</span>{% endif %}
        {% endif %}
        {% if benefit_4 != blank %}<span data-benefit>{{ benefit_4 | escape }}</span>{% endif %}
      </div>
      <span class="crosley-plp-announcement__benefit-mobile" data-mobile-benefit>{{ mobile_benefit | escape }}</span>
    </aside>
    {% endif %}

    {% if section.settings.crosley_show_promotion %}
    <aside class="crosley-plp-announcement__promotion" aria-label="Promotion">
      <div class="crosley-plp-announcement__offer">
        <span>{{ section.settings.crosley_offer_text | escape }}</span>
        {% if section.settings.crosley_link_label != blank %}
          <a href="{{ section.settings.crosley_link | default: routes.all_products_collection_url }}">{{ section.settings.crosley_link_label | escape }}</a>
        {% endif %}
      </div>

      {% if section.settings.crosley_show_countdown %}
      <div class="crosley-plp-announcement__countdown" aria-label="Promotion countdown">
        <span class="crosley-plp-announcement__time">
          <strong data-countdown-value="days">{{ section.settings.crosley_countdown_days }}</strong>
          <small>{{ section.settings.crosley_days_label | escape }}</small>
        </span>
        <span class="crosley-plp-announcement__colon" aria-hidden="true">:</span>
        <span class="crosley-plp-announcement__time">
          <strong data-countdown-value="hours">{{ section.settings.crosley_countdown_hours }}</strong>
          <small>{{ section.settings.crosley_hours_label | escape }}</small>
        </span>
        <span class="crosley-plp-announcement__colon" aria-hidden="true">:</span>
        <span class="crosley-plp-announcement__time">
          <strong data-countdown-value="minutes">{{ section.settings.crosley_countdown_minutes }}</strong>
          <small>{{ section.settings.crosley_minutes_label | escape }}</small>
        </span>
        <span class="crosley-plp-announcement__colon" aria-hidden="true">:</span>
        <span class="crosley-plp-announcement__time">
          <strong data-countdown-value="seconds">{{ section.settings.crosley_countdown_seconds }}</strong>
          <small>{{ section.settings.crosley_seconds_label | escape }}</small>
        </span>
      </div>
      {% endif %}
    </aside>
    {% endif %}
  </crosley-plp-announcement>
{% else %}
  {% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

  <div class="section-background color-custom-{{ section.id }}"></div>
  <aside
    class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
    style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
  >
    {% liquid
      assign autoplay = false
      assign show_arrows = false
      if section.blocks.size > 1
        assign autoplay = true
        assign show_arrows = true
      endif
    %}

    <announcement-bar-component
      class="announcement-bar__slider"
      {% if autoplay == true %}
        autoplay="{{ section.settings.speed }}" aria-live="polite"
      {% endif %}
    >
      {% if show_arrows %}
        {% render 'slideshow-arrows', icon_style: 'chevron' %}
      {% endif %}

      <div class="announcement-bar__slides">
        {% content_for 'blocks' %}
      </div>
    </announcement-bar-component>
  </aside>
{% endif %}

{% stylesheet %}
  .announcement-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    border-block-end: var(--border-bottom-width) solid var(--color-border);
  }

  .announcement-bar__slider {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 100%;

    @media screen and (max-width: 749px) {
      grid-column: 1 / -1;
    }
  }

  .announcement-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] auto;
    width: calc(100% - var(--button-size) * 2);
    max-width: 680px;
    margin-inline: auto;
  }

  .announcement-bar__slides > * {
    grid-area: stack;
  }

  .announcement-bar__slide {
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
    content-visibility: visible;

    &[aria-hidden='true'] {
      opacity: 0;
      visibility: hidden;
    }
  }

  .announcement-bar__slider slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
  }

  .announcement-bar__slider slideshow-arrows .slideshow-control {
    color: var(--color-foreground);
  }

  .announcement-bar__slider .slideshow-control {
    display: flex;
    padding: 0;
    width: var(--button-size);
    height: var(--button-size);
    align-items: center;
    justify-content: center;
    opacity: 1;
    animation: none;

    @media screen and (min-width: 750px) {
      --slideshow-control-offset: calc((var(--button-size) - var(--icon-size-xs)) / 2);

      .section--page-width &.slideshow-control--previous {
        transform: translateX(var(--slideshow-control-offset));
      }
    }
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .announcement-bar__slide {
    display: grid;
    place-content: center;
    text-align: center;
  }

  .announcement-bar__text:first-child {
    margin: 0;
  }

  .announcement-bar__text {
    width: 100%;
    text-align: center;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
  }

  .crosley-plp-announcement {
    display: block;
    color: var(--crosley-announcement-text, #fff);
    font-family: "acumin-pro-condensed", Arial, sans-serif;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
  }

  .crosley-plp-announcement__benefits {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 10px 40px;
    background: var(--crosley-benefits-bg, #383637);
    font-size: 12px;
    letter-spacing: 0.06em;
  }

  .crosley-plp-announcement__benefits-desktop {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .crosley-plp-announcement__separator {
    margin-inline: 10px;
    color: color-mix(in srgb, var(--crosley-announcement-text, #fff) 40%, transparent);
  }

  .crosley-plp-announcement__benefit-mobile {
    display: none;
    font-size: 11px;
  }

  .crosley-plp-announcement__promotion {
    display: flex;
    min-height: 65px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 11px 40px;
    background: var(--crosley-promotion-bg, #171f26);
  }

  .crosley-plp-announcement__offer {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    font-size: clamp(11px, calc(10.49px + 0.1307vw), 13px);
  }

  .crosley-plp-announcement__offer a {
    color: var(--crosley-announcement-text, #fff);
    line-height: normal;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .crosley-plp-announcement__countdown {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .crosley-plp-announcement__time {
    display: flex;
    min-width: 30px;
    flex-direction: column;
    align-items: center;
  }

  .crosley-plp-announcement__time strong {
    font-size: 14px;
    line-height: 1;
  }

  .crosley-plp-announcement__time small {
    margin-top: 5px;
    color: color-mix(in srgb, var(--crosley-announcement-text, #fff) 65%, transparent);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .crosley-plp-announcement__colon {
    color: color-mix(in srgb, var(--crosley-announcement-text, #fff) 40%, transparent);
    font-size: 14px;
  }

  @media screen and (max-width: 860px) {
    .crosley-plp-announcement__benefits-desktop {
      display: none;
    }

    .crosley-plp-announcement__benefit-mobile {
      display: block;
    }
  }

  @media screen and (max-width: 749px) {
    .crosley-plp-announcement__benefits {
      min-height: 36px;
      padding-block: 0;
    }

    .crosley-plp-announcement__benefit-mobile {
      line-height: normal;
    }

    .crosley-plp-announcement__promotion {
      --crosley-countdown-offset: 164px;

      min-height: 85px;
      justify-content: flex-start;
      gap: 24px;
      padding: 11px 40px;
    }

    .crosley-plp-announcement__offer {
      flex: 0 0 100px;
      gap: 12px;
      min-width: 0;
      letter-spacing: 0.06em;
    }

    .crosley-plp-announcement__offer > span {
      width: 100px;
      line-height: normal;
    }

    .crosley-plp-announcement__countdown {
      flex: 0 0 min(240px, calc(100vw - var(--crosley-countdown-offset) - 8px));
      justify-content: space-between;
      gap: 0;
    }

    .crosley-plp-announcement__time {
      min-width: 30px;
    }

    .crosley-plp-announcement__time strong {
      font-weight: 700;
      letter-spacing: 0;
    }

    .crosley-plp-announcement__colon {
      font-size: 14px;
      letter-spacing: 0;
    }
  }

  @media screen and (max-width: 374px) {
    .crosley-plp-announcement__promotion {
      --crosley-countdown-offset: 144px;

      padding-inline: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Collection announcement"
    },
    {
      "type": "checkbox",
      "id": "crosley_show_benefits",
      "label": "Show benefits bar",
      "default": true
    },
    {
      "type": "text",
      "id": "crosley_benefit_1",
      "label": "Benefit 1",
      "default": "Free Delivery",
      "visible_if": "{{ section.settings.crosley_show_benefits }}"
    },
    {
      "type": "text",
      "id": "crosley_benefit_2",
      "label": "Benefit 2",
      "default": "Buy Now Pay Later",
      "visible_if": "{{ section.settings.crosley_show_benefits }}"
    },
    {
      "type": "text",
      "id": "crosley_benefit_3",
      "label": "Benefit 3",
      "default": "Technical Support",
      "visible_if": "{{ section.settings.crosley_show_benefits }}"
    },
    {
      "type": "text",
      "id": "crosley_benefit_4",
      "label": "Benefit 4",
      "default": "One-Year Warranty",
      "visible_if": "{{ section.settings.crosley_show_benefits }}"
    },
    {
      "type": "range",
      "id": "crosley_mobile_rotation_speed",
      "label": "Mobile benefit rotation",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "sec",
      "default": 3,
      "visible_if": "{{ section.settings.crosley_show_benefits }}"
    },
    {
      "type": "checkbox",
      "id": "crosley_show_promotion",
      "label": "Show promotion bar",
      "default": true
    },
    {
      "type": "text",
      "id": "crosley_offer_text",
      "label": "Promotion text",
      "default": "Save up to 25% on select turntables",
      "visible_if": "{{ section.settings.crosley_show_promotion }}"
    },
    {
      "type": "text",
      "id": "crosley_link_label",
      "label": "Link label",
      "default": "Shop Now",
      "visible_if": "{{ section.settings.crosley_show_promotion }}"
    },
    {
      "type": "url",
      "id": "crosley_link",
      "label": "Link",
      "visible_if": "{{ section.settings.crosley_show_promotion }}"
    },
    {
      "type": "checkbox",
      "id": "crosley_show_countdown",
      "label": "Show countdown",
      "default": true,
      "visible_if": "{{ section.settings.crosley_show_promotion }}"
    },
    {
      "type": "range",
      "id": "crosley_countdown_days",
      "label": "Days",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 12,
      "visible_if": "{{ section.settings.crosley_show_promotion and section.settings.crosley_show_countdown }}"
    },
    {
      "type": "range",
      "id": "crosley_countdown_hours",
      "label": "Hours",
      "min": 0,
      "max": 23,
      "step": 1,
      "default": 7,
      "visible_if": "{{ section.settings.crosley_show_promotion and section.settings.crosley_show_countdown }}"
    },
    {
      "type": "range",
      "id": "crosley_countdown_minutes",
      "label": "Minutes",
      "min": 0,
      "max": 59,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.crosley_show_promotion and section.settings.crosley_show_countdown }}"
    },
    {
      "type": "range",
      "id": "crosley_countdown_seconds",
      "label": "Seconds",
      "min": 0,
      "max": 59,
      "step": 1,
      "default": 52,
      "visible_if": "{{ section.settings.crosley_show_promotion and section.settings.crosley_show_countdown }}"
    },
    {
      "type": "text",
      "id": "crosley_days_label",
      "label": "Days label",
      "default": "Day",
      "visible_if": "{{ section.settings.crosley_show_promotion and section.settings.crosley_show_countdown }}"
    },
    {
      "type": "text",
      "id": "crosley_hours_label",
      "label": "Hours label",
      "default": "Hrs",
      "visible_if": "{{ section.settings.crosley_show_promotion and section.settings.crosley_show_countdown }}"
    },
    {
      "type": "text",
      "id": "crosley_minutes_label",
      "label": "Minutes label",
      "default": "Min",
      "visible_if": "{{ section.settings.crosley_show_promotion and section.settings.crosley_show_countdown }}"
    },
    {
      "type": "text",
      "id": "crosley_seconds_label",
      "label": "Seconds label",
      "default": "Sec",
      "visible_if": "{{ section.settings.crosley_show_promotion and section.settings.crosley_show_countdown }}"
    },
    {
      "type": "color",
      "id": "crosley_benefits_background",
      "label": "Benefits background",
      "default": "#383637"
    },
    {
      "type": "color",
      "id": "crosley_promotion_background",
      "label": "Promotion background",
      "default": "#171f26"
    },
    {
      "type": "color",
      "id": "crosley_text_color",
      "label": "Collection announcement text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Standard announcement"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
