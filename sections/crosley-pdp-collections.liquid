{% comment %}
  Merchant-configurable collection cards for the alternate Crosley PDP.
{% endcomment %}

{% assign heading_tag = section.settings.heading_tag | default: 'h2' %}

<section class="crosley-pdp-collections">
  <div class="crosley-pdp-collections__inner">
    <{{ heading_tag }} class="crosley-pdp-collections__heading">{{ section.settings.heading | escape }}</{{ heading_tag }}>
    <div class="crosley-pdp-collections__grid">
      {% for block in section.blocks %}
        {% liquid
          assign card_collection = block.settings.collection
          assign card_image = block.settings.image
          if card_image == blank
            assign card_image = card_collection.image
          endif
          if card_image == blank
            assign card_image = card_collection.products.first.featured_image
          endif
          assign card_title = block.settings.label | default: card_collection.title
          assign card_link = card_collection.url | default: routes.all_products_collection_url
        %}
        <a class="crosley-pdp-collection-card" href="{{ card_link }}" {{ block.shopify_attributes }}>
          {% if card_image != blank %}
            {{ card_image | image_url: width: 1000 | image_tag: widths: '360, 540, 720, 1000', sizes: '(min-width: 750px) 33vw, 88vw', loading: 'lazy', alt: card_title }}
          {% else %}
            {{ 'collection-apparel-1' | placeholder_svg_tag: 'crosley-pdp-collection-card__placeholder' }}
          {% endif %}
          <span aria-hidden="true"></span>
          <strong>{{ card_title | escape }}</strong>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .crosley-pdp-collections {
    width: 100%;
    padding: clamp(40px, 3.47vw, 50px) 40px clamp(40px, 5.7vw, 82px);
    background: #fff;
  }

  .crosley-pdp-collections__inner {
    width: 100%;
    margin-inline: auto;
  }

  .crosley-pdp-collections__heading {
    margin: 0 0 40px;
    color: #676767;
    font-size: clamp(18px, 1.05vw + 9.5px, 24px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.05em;
    text-align: center;
    text-transform: uppercase;
  }

  .crosley-pdp-collections__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .crosley-pdp-collection-card {
    position: relative;
    display: block;
    min-width: 0;
    aspect-ratio: 1;
    overflow: hidden;
    color: #fff;
    background: #ececeb;
  }

  .crosley-pdp-collection-card img,
  .crosley-pdp-collection-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 250ms ease;
  }

  .crosley-pdp-collection-card > span {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 58%, rgb(0 0 0 / 46%));
  }

  .crosley-pdp-collection-card strong {
    position: absolute;
    bottom: 26px;
    left: 26px;
    color: #fff;
    font-size: clamp(18px, 1.05vw + 9.5px, 24px);
    font-weight: 700;
    text-transform: uppercase;
  }

  .crosley-pdp-collection-card:hover img { transform: scale(1.025); }

  @media (max-width: 860px) {
    .crosley-pdp-collections { padding: 0 0 48px; }
    .crosley-pdp-collections__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .crosley-pdp-collections__heading {
      margin-block-end: 40px;
      padding-inline: 20px;
    }
    .crosley-pdp-collection-card strong {
      bottom: 20px;
      left: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .crosley-pdp-collection-card img { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Crosley PDP collections",
  "tag": "section",
  "class": "crosley-pdp-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore our collections" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Select an image uploaded to Shopify Files. Uses the collection image when blank." },
        { "type": "text", "id": "label", "label": "Custom label" }
      ]
    }
  ],
  "presets": [{ "name": "Crosley PDP collections", "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }] }]
}
{% endschema %}
