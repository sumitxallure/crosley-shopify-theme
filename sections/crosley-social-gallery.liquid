{% assign heading_tag = section.settings.heading_tag | default: 'h2' %}

<section class="crosley-social-gallery">
  <p>{{ section.settings.eyebrow | escape }}</p>
  <{{ heading_tag }} class="crosley-social-gallery__heading">{{ section.settings.heading | escape }}</{{ heading_tag }}>
  <div class="crosley-social-gallery__grid">
    {% for block in section.blocks %}
      {% liquid
        assign fallback_asset = 'crosley-social-' | append: forloop.index | append: '.jpg'
        assign image_alt = block.settings.image.alt | default: section.settings.heading
      %}
      <a href="{{ block.settings.link | default: '#' }}" aria-label="{{ block.settings.label | default: 'View social post' | escape }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 900 | image_tag: widths: '320, 500, 700, 900', sizes: '(min-width: 990px) 20vw, 72vw', loading: 'lazy', alt: image_alt }}
        {% else %}
          <img src="{{ fallback_asset | asset_url }}" alt="{{ image_alt | escape }}" width="800" height="800" loading="lazy">
        {% endif %}
      </a>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .crosley-social-gallery {
    padding: 50px 0 40px;
    overflow: hidden;
    text-align: center;
    background: #f5f5f4;
  }

  .crosley-social-gallery > p {
    margin: 0 0 20px;
    color: #676767;
    font-size: clamp(12px, calc(11.235px + 0.1961vw), 15px);
    font-weight: 700;
    text-transform: uppercase;
  }

  .crosley-social-gallery__heading {
    margin: 0 0 56px;
    color: #171f26;
    font-size: clamp(24px, calc(21.96px + 0.5229vw), 32px);
    text-transform: uppercase;
  }

  .crosley-social-gallery__grid {
    display: grid;
    width: auto;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 24px;
    margin-inline: clamp(40px, 7.03vw, 160px);
  }

  .crosley-social-gallery__grid a {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .crosley-social-gallery__grid img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 260ms ease;
  }

  .crosley-social-gallery__grid a:hover img {
    transform: scale(1.03);
  }

  @media (max-width: 600px) {
    .crosley-social-gallery__grid {
      display: flex;
      width: 100%;
      gap: 12px;
      margin-inline: 0;
      padding-inline-start: 16px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .crosley-social-gallery__grid::-webkit-scrollbar {
      display: none;
    }

    .crosley-social-gallery__grid a {
      flex: 0 0 80%;
      scroll-snap-align: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .crosley-social-gallery__grid img {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Crosley social gallery",
  "tag": "section",
  "class": "crosley-home-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "@CrosleyRadio" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Social image",
      "settings": [
        { "type": "header", "content": "Image" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "header", "content": "Link" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "header", "content": "Accessibility" },
        { "type": "text", "id": "label", "label": "Accessible label", "default": "View social post" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Crosley social gallery",
      "blocks": [
        { "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
