{% comment %}
  Merchant-curated collection cards for the Crosley homepage.
  @example
  Add collection blocks and optionally override each collection image and label.
{% endcomment %}

<section
  class="crosley-categories"
  style="
    --crosley-category-gap: {{ section.settings.gap }}px;
    --crosley-category-bg: {{ section.settings.background_color }};
  "
>
  <div class="crosley-categories__header">
    {% if section.settings.eyebrow != blank %}
      <p>{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading | escape }}</h2>
    {% endif %}
  </div>

  <div class="crosley-categories__grid">
    {% for block in section.blocks %}
      {% liquid
        assign card_collection = block.settings.collection
        assign card_image = block.settings.image
        if card_image == blank and card_collection.image != blank
          assign card_image = card_collection.image
        endif
        if card_image == blank and card_collection.products.first.featured_image != blank
          assign card_image = card_collection.products.first.featured_image
        endif
        assign card_title = block.settings.label | default: card_collection.title
        assign card_link = card_collection.url | default: routes.all_products_collection_url
      %}

      <a class="crosley-category-card" href="{{ card_link }}" {{ block.shopify_attributes }}>
        <div class="crosley-category-card__media">
          {% if card_image != blank %}
            {{
              card_image
              | image_url: width: 1400
              | image_tag:
                widths: '360, 540, 720, 1000, 1400',
                sizes: '(min-width: 990px) 25vw, 50vw',
                loading: 'lazy',
                alt: card_title
            }}
          {% else %}
            {{ 'collection-apparel-1' | placeholder_svg_tag: 'crosley-category-card__placeholder' }}
          {% endif %}
        </div>
        <span class="crosley-category-card__title">{{ card_title | escape }}</span>
      </a>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .crosley-categories {
    width: min(calc(100% - 48px), 1600px);
    margin-inline: auto;
    padding-block: clamp(54px, 7vw, 96px);
    background: var(--crosley-category-bg);
  }

  .crosley-categories__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-block-end: 32px;
  }

  .crosley-categories__header p {
    margin: 0;
    color: #676767;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .crosley-categories__header h2 {
    margin: 0;
    color: #171f26;
    font-size: clamp(1.8rem, 3vw, 3rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .crosley-categories__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--crosley-category-gap);
  }

  .crosley-category-card {
    min-width: 0;
    color: #171f26;
    text-decoration: none;
  }

  .crosley-category-card__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #ececeb;
  }

  .crosley-category-card__media img,
  .crosley-category-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .crosley-category-card:hover .crosley-category-card__media img {
    transform: scale(1.025);
  }

  .crosley-category-card__title {
    display: block;
    margin-block-start: 15px;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  @media (max-width: 989px) {
    .crosley-categories__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 749px) {
    .crosley-categories {
      width: min(calc(100% - 40px), 1600px);
      padding-block: 52px;
    }

    .crosley-categories__header {
      display: block;
      margin-block-end: 24px;
    }

    .crosley-categories__header p {
      margin-block-end: 10px;
    }

    .crosley-categories__grid {
      gap: 20px 12px;
    }

    .crosley-category-card__title {
      font-size: 0.86rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .crosley-category-card__media img {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Crosley categories",
  "tag": "section",
  "class": "crosley-home-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured categories"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Card spacing",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Defaults to the collection or first product image."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Custom label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Crosley categories",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
