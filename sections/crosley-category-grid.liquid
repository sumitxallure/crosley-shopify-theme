{% comment %}
  Merchant-curated collection cards for the Crosley homepage.
  @example
  Add collection blocks and optionally override each collection image and label.
{% endcomment %}

<section
  class="crosley-categories"
  style="
    --crosley-category-gap: {{ section.settings.gap }}px;
    --crosley-category-bg: {{ section.settings.background_color }};
  "
>
  <div class="crosley-categories__header">
    {% if section.settings.eyebrow != blank %}
      <p>{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading | escape }}</h2>
    {% endif %}
  </div>

  <div class="crosley-categories__grid">
    {% for block in section.blocks %}
      {% liquid
        assign card_collection = block.settings.collection
        assign card_image = block.settings.image
        if card_image == blank and card_collection.image != blank
          assign card_image = card_collection.image
        endif
        if card_image == blank and card_collection.products.first.featured_image != blank
          assign card_image = card_collection.products.first.featured_image
        endif
        assign card_title = block.settings.label | default: card_collection.title
        assign card_link = card_collection.url | default: routes.all_products_collection_url
      %}

      <a class="crosley-category-card" href="{{ card_link }}" {{ block.shopify_attributes }}>
        <div class="crosley-category-card__media">
          {% if card_image != blank %}
            {{
              card_image
              | image_url: width: 1400
              | image_tag:
                widths: '360, 540, 720, 1000, 1400',
                sizes: '(min-width: 990px) 25vw, 50vw',
                loading: 'lazy',
                alt: card_title
            }}
          {% else %}
            {{ 'collection-apparel-1' | placeholder_svg_tag: 'crosley-category-card__placeholder' }}
          {% endif %}
          <span class="crosley-category-card__shade"></span>
          <span class="crosley-category-card__content">
            <strong>{{ card_title | escape }}</strong>
            <span>{{ section.settings.button_label | escape }}</span>
          </span>
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .crosley-categories {
    width: 100%;
    padding: clamp(40px, calc(29.29px + 2.7451vw), 82px) clamp(16px, calc(7.33px + 2.2222vw), 50px);
    background: var(--crosley-category-bg);
  }

  .crosley-categories__header {
    margin-block-end: 48px;
    text-align: center;
  }

  .crosley-categories__header p {
    margin: 0;
    color: #676767;
    font-size: clamp(12px, calc(11.235px + 0.1961vw), 15px);
    font-weight: 700;
    text-transform: uppercase;
  }

  .crosley-categories__header h2 {
    margin: 0;
    color: #171f26;
    font-size: clamp(24px, calc(21.96px + 0.5229vw), 32px);
    line-height: 1.15;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .crosley-categories__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--crosley-category-gap);
    width: min(100%, 1600px);
    margin-inline: auto;
  }

  .crosley-category-card {
    min-width: 0;
    color: #171f26;
    text-decoration: none;
  }

  .crosley-category-card__media {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: #ececeb;
  }

  .crosley-category-card__media img,
  .crosley-category-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .crosley-category-card:hover .crosley-category-card__media img {
    transform: scale(1.025);
  }

  .crosley-category-card__shade {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 25%);
    pointer-events: none;
  }

  .crosley-category-card__content {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding: 28px;
    color: #ffffff;
    text-align: left;
  }

  .crosley-category-card__content strong {
    font-size: clamp(20px, calc(17.96px + 0.5229vw), 28px);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .crosley-category-card__content > span {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    padding-inline: 24px;
    color: #383637;
    background: #ffffff;
    border: 1px solid #ffffff;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 600px) {
    .crosley-categories__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .crosley-categories {
      padding: 40px 16px;
    }

    .crosley-categories__header {
      display: block;
      margin-block-end: 20px;
    }

    .crosley-categories__header p {
      margin-block-end: 10px;
    }

    .crosley-categories__grid {
      gap: 12px;
    }

    .crosley-category-card__content {
      gap: 10px;
      padding: 12px;
    }

    .crosley-category-card__content > span {
      min-height: 38px;
      padding-inline: 14px;
      font-size: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .crosley-category-card__media img {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Crosley categories",
  "tag": "section",
  "class": "crosley-home-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured categories"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Card spacing",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View products"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "header",
          "content": "Collection"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "header",
          "content": "Card override"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Defaults to the collection or first product image."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Custom label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Crosley categories",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
