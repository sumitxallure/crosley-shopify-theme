{% comment %}
  Merchant-editable Crosley campaign slider based on the supplied homepage reference.
{% endcomment %}

<section
  class="crosley-hero-slider"
  data-crosley-hero
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.autoplay_seconds | times: 1000 }}"
  style="--hero-height: {{ section.settings.desktop_height }}px; --hero-mobile-height: {{ section.settings.mobile_height }}px;"
>
  <div class="crosley-hero-slider__slides">
    {% for block in section.blocks %}
      {% liquid
        assign fallback_asset = 'crosley-home-hero.jpg'
        if block.settings.fallback_image == 'cd'
          assign fallback_asset = 'crosley-hero-cd.jpg'
        endif
        assign image_alt = block.settings.image.alt | default: block.settings.heading
      %}
      <article
        class="crosley-hero-slide crosley-hero-slide--{{ block.settings.content_position }}{% if forloop.first %} is-active{% endif %}"
        data-hero-slide
        data-block-id="{{ block.id }}"
        aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
        {{ block.shopify_attributes }}
      >
        <div class="crosley-hero-slide__media">
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 3200
              | image_tag:
                widths: '750, 1100, 1500, 2000, 2600, 3200',
                sizes: '100vw',
                loading: 'eager',
                alt: image_alt
            }}
          {% else %}
            <img
              src="{{ fallback_asset | asset_url }}"
              alt="{{ image_alt | escape }}"
              width="2000"
              height="1000"
              loading="eager"
            >
          {% endif %}
        </div>
        <div
          class="crosley-hero-slide__overlay"
          style="background: rgba(23, 31, 38, {{ block.settings.overlay_opacity | divided_by: 100.0 }});"
        ></div>
        <div class="crosley-hero-slide__content">
          <div class="crosley-hero-slide__copy{% if block.settings.framed_content %} crosley-hero-slide__copy--framed{% endif %}">
            {% if block.settings.eyebrow != blank %}
              <p>{{ block.settings.eyebrow | escape }}</p>
            {% endif %}
            {% if block.settings.heading != blank %}
              <h1>{{ block.settings.heading | escape }}</h1>
            {% endif %}
            {% if block.settings.button_label != blank and block.settings.button_link != blank %}
              <a href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>
            {% endif %}
          </div>
        </div>
      </article>
    {% endfor %}
  </div>

  {% if section.blocks.size > 1 %}
    <div class="crosley-hero-slider__dots" role="tablist" aria-label="Hero slides">
      {% for block in section.blocks %}
        <button
          type="button"
          class="crosley-hero-slider__dot{% if forloop.first %} is-active{% endif %}"
          data-hero-dot="{{ forloop.index0 }}"
          aria-label="Show slide {{ forloop.index }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
        ></button>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .crosley-hero-slider {
    position: relative;
    height: var(--hero-height);
    overflow: visible;
    color: #ffffff;
    background: #171f26;
  }

  .crosley-hero-slider__slides,
  .crosley-hero-slide,
  .crosley-hero-slide__media,
  .crosley-hero-slide__media img {
    width: 100%;
    height: 100%;
  }

  .crosley-hero-slide {
    position: absolute;
    inset: 0;
    overflow: hidden;
    visibility: hidden;
    opacity: 0;
    transition: opacity 700ms ease, visibility 700ms ease;
  }

  .crosley-hero-slide.is-active {
    visibility: visible;
    opacity: 1;
  }

  .crosley-hero-slide__media img {
    display: block;
    object-fit: cover;
  }

  .crosley-hero-slide__overlay {
    position: absolute;
    inset: 0;
  }

  .crosley-hero-slide__content {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: flex;
    width: 100%;
    align-items: center;
    margin-inline: 0;
    padding: 0 40px 0 64px;
    pointer-events: none;
  }

  .crosley-hero-slide--center .crosley-hero-slide__content {
    justify-content: center;
    text-align: center;
  }

  .crosley-hero-slide--right .crosley-hero-slide__content {
    justify-content: flex-end;
    text-align: right;
  }

  .crosley-hero-slide:not(.crosley-hero-slide--center) .crosley-hero-slide__copy {
    max-width: 460px;
  }

  .crosley-hero-slide:not(.crosley-hero-slide--center) .crosley-hero-slide__copy p {
    text-transform: uppercase;
  }

  .crosley-hero-slide__copy {
    width: min(100%, 500px);
    pointer-events: auto;
  }

  .crosley-hero-slide__copy--framed {
    padding: clamp(40px, calc(33.88px + 1.5686vw), 64px) 56px;
    border: 1px solid rgb(255 255 255 / 70%);
  }

  .crosley-hero-slide__copy p {
    margin: 0 0 18px;
    color: rgb(255 255 255 / 85%);
    font-size: clamp(12px, calc(11.235px + 0.1961vw), 15px);
    font-weight: 700;
    line-height: normal;
    letter-spacing: 0.03em;
  }

  .crosley-hero-slide__copy h1 {
    margin: 0;
    color: inherit;
    font-size: clamp(34px, calc(26.35px + 1.9608vw), 64px);
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .crosley-hero-slide__copy a {
    display: inline-flex;
    margin-block-start: 32px;
    padding: 16px 40px;
    color: #383637;
    background: #ffffff;
    border: 1px solid #ffffff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color 180ms ease, background 180ms ease;
  }

  .crosley-hero-slide__copy a:hover {
    color: #ffffff;
    background: transparent;
  }

  .crosley-hero-slider__dots {
    position: absolute;
    z-index: 2;
    right: 40px;
    bottom: 28px;
    display: flex;
    gap: 8px;
  }

  .crosley-hero-slider__dot {
    width: 7px;
    height: 7px;
    padding: 0;
    background: rgb(255 255 255 / 50%);
    border: 0;
    border-radius: 50%;
    cursor: pointer;
  }

  .crosley-hero-slider__dot.is-active {
    background: #ffffff;
  }

  @media (max-width: 600px) {
    .crosley-hero-slider {
      height: var(--hero-mobile-height);
    }

    .crosley-hero-slide__content {
      padding: 0 24px;
    }

    .crosley-hero-slide--center .crosley-hero-slide__content {
      padding-inline: 0;
    }

    .crosley-hero-slide__copy--framed {
      width: calc(100% - 32px);
      max-width: 500px;
      padding: 32px 24px;
      box-sizing: border-box;
    }

    .crosley-hero-slide__copy {
      max-width: 100%;
      margin-inline: auto;
    }

    .crosley-hero-slide__copy h1 {
      font-size: clamp(34px, calc(26.35px + 1.9608vw), 64px);
    }

    .crosley-hero-slide__copy a {
      display: inline-flex;
      min-height: 42px;
      align-items: center;
      justify-content: center;
      padding: 0 20px;
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .crosley-hero-slide,
    .crosley-hero-slide__copy a {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  function initializeCrosleyHero(hero) {
    if (hero.dataset.initialized === 'true') return;
    hero.dataset.initialized = 'true';

    const slides = Array.from(hero.querySelectorAll('[data-hero-slide]'));
    const dots = Array.from(hero.querySelectorAll('[data-hero-dot]'));
    let activeIndex = 0;
    let timer;

    const showSlide = (index) => {
      activeIndex = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        const active = slideIndex === activeIndex;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', String(!active));
      });
      dots.forEach((dot, dotIndex) => {
        const active = dotIndex === activeIndex;
        dot.classList.toggle('is-active', active);
        dot.setAttribute('aria-selected', String(active));
      });
    };

    const startTimer = () => {
      window.clearInterval(timer);
      if (hero.dataset.autoplay === 'true' && slides.length > 1) {
        timer = window.setInterval(() => showSlide(activeIndex + 1), Number(hero.dataset.interval));
      }
    };

    dots.forEach((dot) => dot.addEventListener('click', () => {
      showSlide(Number(dot.dataset.heroDot));
      startTimer();
    }));

    document.addEventListener('shopify:block:select', (event) => {
      const index = slides.findIndex((slide) => slide.dataset.blockId === event.detail.blockId);
      if (index >= 0) showSlide(index);
    });

    startTimer();
  }

  document.querySelectorAll('[data-crosley-hero]').forEach(initializeCrosleyHero);
  document.addEventListener('shopify:section:load', (event) => {
    event.target.querySelectorAll('[data-crosley-hero]').forEach(initializeCrosleyHero);
  });
{% endjavascript %}

{% schema %}
{
  "name": "Crosley hero slider",
  "tag": "section",
  "class": "crosley-home-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Behavior" },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "autoplay_seconds", "label": "Time per slide", "min": 4, "max": 10, "step": 1, "unit": "s", "default": 7 },
    { "type": "header", "content": "Size" },
    { "type": "range", "id": "desktop_height", "label": "Desktop height", "min": 600, "max": 900, "step": 20, "unit": "px", "default": 860 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 520, "max": 760, "step": 5, "unit": "px", "default": 645 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "header", "content": "Media" },
        { "type": "image_picker", "id": "image", "label": "Background image" },
        {
          "type": "select",
          "id": "fallback_image",
          "label": "Bundled image",
          "options": [
            { "value": "cd", "label": "CD player campaign" },
            { "value": "c65", "label": "C65 campaign" }
          ],
          "default": "c65"
        },
        { "type": "header", "content": "Content" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Designed to be seen. Built to be heard" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "The C65" },
        { "type": "header", "content": "Button" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "header", "content": "Layout" },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content position",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        { "type": "header", "content": "Style" },
        { "type": "checkbox", "id": "framed_content", "label": "Show frame around content", "default": false },
        { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 70, "step": 5, "unit": "%", "default": 45 }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Crosley hero slider",
      "blocks": [
        { "type": "slide", "settings": { "fallback_image": "cd", "eyebrow": "The CD comeback, done right", "heading": "Find your next CD player", "button_label": "Shop now", "content_position": "center", "framed_content": true } },
        { "type": "slide", "settings": { "fallback_image": "c65", "eyebrow": "Designed to be seen. Built to be heard", "heading": "The C65", "button_label": "Shop", "content_position": "left", "framed_content": false } }
      ]
    }
  ]
}
{% endschema %}
