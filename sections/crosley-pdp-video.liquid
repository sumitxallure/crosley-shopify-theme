{% comment %}
  Renders the first Shopify-hosted or external video from the current product's media.
{% endcomment %}

{% assign heading_tag = section.settings.heading_tag | default: 'h2' %}

{% liquid
  assign video_heading = section.settings.heading | default: product.title

  for media in product.media
    if media.media_type == 'video'
      assign product_video = media
      break
    elsif media.media_type == 'external_video'
      assign product_external_video = media
      break
    endif
  endfor
%}

{% if product_video != blank or product_external_video != blank %}
  <section class="crosley-pdp-video" data-crosley-pdp-video>
    {% if product_video != blank %}
      {{
        product_video
        | video_tag:
          class: 'crosley-pdp-video__player',
          controls: true,
          image_size: '2000x',
          preload: 'metadata'
      }}
    {% elsif product_external_video != blank %}
      <div class="crosley-pdp-video__embed" data-video-provider="{{ product_external_video.host }}" data-video-id="{{ product_external_video.external_id }}">
        {% if product_external_video.preview_image != blank %}
          {{ product_external_video.preview_image | image_url: width: 2200 | image_tag: widths: '750, 1100, 1500, 2000, 2200', sizes: '100vw', loading: 'lazy', alt: video_heading }}
        {% endif %}
      </div>
    {% endif %}

    <div class="crosley-pdp-video__overlay">
      {% if section.settings.eyebrow != blank %}<p class="crosley-pdp-video__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if video_heading != blank %}<{{ heading_tag }} class="crosley-pdp-video__heading">{{ video_heading | escape }}</{{ heading_tag }}>{% endif %}
      <button type="button" class="crosley-pdp-video__play" aria-label="Play product video">
        <span aria-hidden="true"></span>
      </button>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .crosley-pdp-video {
    position: relative;
    width: 100%;
    height: clamp(300px, 28vw, 400px);
    overflow: hidden;
    color: #fff;
    background: #171f26;
  }

  .crosley-pdp-video__player,
  .crosley-pdp-video__embed,
  .crosley-pdp-video__embed img,
  .crosley-pdp-video iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  .crosley-pdp-video__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    padding: 32px;
    text-align: center;
    background: rgb(23 31 38 / 35%);
    pointer-events: none;
    transition: opacity 180ms ease;
  }

  .crosley-pdp-video.is-playing .crosley-pdp-video__overlay {
    opacity: 0;
  }

  .crosley-pdp-video__play {
    position: relative;
    width: 68px;
    height: 68px;
    margin-block-start: 32px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: #383637;
    background: #fff;
    cursor: pointer;
    pointer-events: auto;
  }

  .crosley-pdp-video__play span {
    position: absolute;
    top: 50%;
    left: 52%;
    width: 0;
    height: 0;
    border-block: 8px solid transparent;
    border-inline-start: 13px solid currentColor;
    transform: translate(-50%, -50%);
  }

  .crosley-pdp-video__heading {
    margin: 0;
    color: inherit;
    font-size: clamp(24px, calc(21.96px + 0.5229vw), 32px);
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .crosley-pdp-video__eyebrow {
    margin: 0 0 18px;
    color: rgb(255 255 255 / 85%);
    font-size: clamp(11px, calc(10.49px + 0.1307vw), 13px);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 860px) {
    .crosley-pdp-video {
      height: 300px;
    }

    .crosley-pdp-video__overlay {
      padding: 24px 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .crosley-pdp-video__overlay {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  function initializeCrosleyPdpVideo(section) {
    if (section.dataset.initialized === 'true') return;
    section.dataset.initialized = 'true';

    const playButton = section.querySelector('.crosley-pdp-video__play');
    const nativeVideo = section.querySelector('video');
    const embed = section.querySelector('.crosley-pdp-video__embed');
    if (!playButton) return;

    playButton.addEventListener('click', async () => {
      if (nativeVideo) {
        await nativeVideo.play();
        section.classList.add('is-playing');
        nativeVideo.focus();
        return;
      }

      if (!embed) return;
      const provider = embed.dataset.videoProvider;
      const videoId = embed.dataset.videoId;
      if (!provider || !videoId) return;
      const iframe = document.createElement('iframe');
      iframe.title = 'Product video';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.src = provider === 'youtube'
        ? `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`
        : `https://player.vimeo.com/video/${videoId}?autoplay=1`;
      embed.replaceChildren(iframe);
      section.classList.add('is-playing');
      iframe.focus();
    });
  }

  document.querySelectorAll('[data-crosley-pdp-video]').forEach(initializeCrosleyPdpVideo);
  document.addEventListener('shopify:section:load', (event) => {
    event.target.querySelectorAll('[data-crosley-pdp-video]').forEach(initializeCrosleyPdpVideo);
  });
{% endjavascript %}

{% schema %}
{
  "name": "Crosley PDP video",
  "tag": "section",
  "class": "crosley-pdp-section crosley-pdp-section--video",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "See it in action" },
    { "type": "text", "id": "heading", "label": "Heading override", "info": "Uses the current product title when left blank." },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    }
  ],
  "presets": [{ "name": "Crosley PDP video" }]
}
{% endschema %}
