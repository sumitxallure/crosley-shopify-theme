<section class="crosley-benefits">
  <div class="crosley-benefits__grid">
    {% for block in section.blocks %}
      <article class="crosley-benefit" {{ block.shopify_attributes }}>
        <span class="crosley-benefit__icon" aria-hidden="true">
          {% case block.settings.icon %}
            {% when 'delivery' %}
              <svg viewBox="0 0 32 32"><path d="M4 10 16 4l12 6v12l-12 6-12-6V10Z"/><path d="m4 10 12 6 12-6M16 16v12"/></svg>
            {% when 'payments' %}
              <svg viewBox="0 0 32 32"><path d="M6 10c2-4 6-6 10-6 6 0 11 5 11 11s-5 11-11 11S5 21 5 15"/><path d="M6 4v6h6"/></svg>
            {% when 'support' %}
              <svg viewBox="0 0 32 32"><rect x="5" y="6" width="22" height="16" rx="1.5"/><path d="M9 26h14"/><circle cx="16" cy="14" r="4"/></svg>
            {% else %}
              <svg viewBox="0 0 32 32"><circle cx="16" cy="12" r="8"/><path d="m11 18.5-2 9.5 7-4 7 4-2-9.5"/></svg>
          {% endcase %}
        </span>
        <h3>{{ block.settings.heading | escape }}</h3>
        <p>{{ block.settings.text | escape }}</p>
      </article>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .crosley-benefits {
    padding: 50px 40px;
    text-align: center;
    background: #f5f5f4;
  }

  .crosley-benefits__grid {
    display: grid;
    width: min(100%, 1400px);
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    margin-inline: auto;
  }

  .crosley-benefit__icon {
    display: block;
    width: 32px;
    height: 32px;
    margin: 0 auto 20px;
  }

  .crosley-benefit__icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: #171f26;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .crosley-benefit h3 {
    margin: 0 0 10px;
    color: #171f26;
    font-size: 1rem;
    text-transform: uppercase;
  }

  .crosley-benefit p {
    margin: 0;
    color: #676767;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  @media (max-width: 749px) {
    .crosley-benefits {
      overflow: hidden;
      padding-inline: 0;
    }

    .crosley-benefits__grid {
      display: flex;
      width: 100%;
      gap: 0;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .crosley-benefits__grid::-webkit-scrollbar {
      display: none;
    }

    .crosley-benefit {
      flex: 0 0 100%;
      padding-inline: 40px;
      scroll-snap-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Crosley benefits",
  "tag": "section",
  "class": "crosley-home-section",
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "delivery", "label": "Delivery" },
            { "value": "payments", "label": "Payments" },
            { "value": "support", "label": "Support" },
            { "value": "warranty", "label": "Warranty" }
          ],
          "default": "delivery"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Free delivery" },
        { "type": "text", "id": "text", "label": "Text", "default": "Every order ships for free to the continental U.S." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Crosley benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "delivery", "heading": "Free delivery", "text": "Every order ships for free to the continental U.S." } },
        { "type": "benefit", "settings": { "icon": "payments", "heading": "Buy now pay later", "text": "Split your order into four payments with Sezzle." } },
        { "type": "benefit", "settings": { "icon": "support", "heading": "Technical support", "text": "Have a problem? We are here to help." } },
        { "type": "benefit", "settings": { "icon": "warranty", "heading": "One-year warranty", "text": "Our products are covered for an entire year." } }
      ]
    }
  ]
}
{% endschema %}
