{% assign newsletter_heading_tag = section.settings.newsletter_heading_tag | default: 'h2' %}

<footer class="crosley-footer">
  <div class="crosley-footer__inner">
    <div class="crosley-footer__newsletter" aria-labelledby="FooterNewsletter-{{ section.id }}">
      <{{ newsletter_heading_tag }} id="FooterNewsletter-{{ section.id }}" class="crosley-footer__newsletter-heading">{{ section.settings.newsletter_heading | escape }}</{{ newsletter_heading_tag }}>
      <p>{{ section.settings.newsletter_text | escape }}</p>
      {% form 'customer', class: 'crosley-footer__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="FooterEmail-{{ section.id }}">Email address</label>
        <input
          id="FooterEmail-{{ section.id }}"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="E-mail"
          autocomplete="email"
          aria-required="true"
          {% if form.errors %}aria-invalid="true" aria-describedby="FooterNewsletterError-{{ section.id }}"{% endif %}
          required
        >
        <button type="submit">Subscribe</button>
        {% if form.errors %}
          <p id="FooterNewsletterError-{{ section.id }}" class="crosley-footer__form-message" role="alert">
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </p>
        {% endif %}
        {% if form.posted_successfully? %}
          <p class="crosley-footer__form-message" role="status">Thanks for subscribing.</p>
        {% endif %}
      {% endform %}
      <div class="crosley-footer__social">
        {% if section.settings.facebook_url != blank %}
          <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V8c0-.9.25-1.5 1.55-1.5h1.65V3.7C15.9 3.6 15 3.5 14 3.5c-2.4 0-4 1.45-4 4.1v2.3H7.3V13H10v8h3.5Z"/></svg>
          </a>
        {% endif %}
        {% if section.settings.twitter_url != blank %}
          <a href="{{ section.settings.twitter_url }}" target="_blank" rel="noopener" aria-label="X">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 3H22l-7.2 8.2L23 21h-6.8l-5.3-6.4L5 21H2l7.7-8.8L1.5 3h7l4.8 5.8L18.9 3Zm-1.2 16h1.9L7.4 5h-2l12.3 14Z"/></svg>
          </a>
        {% endif %}
        {% if section.settings.instagram_url != blank %}
          <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4.5"/><circle cx="12" cy="12" r="4.2"/><circle class="crosley-footer__social-dot" cx="17.2" cy="6.8" r="1.1"/></svg>
          </a>
        {% endif %}
        {% if section.settings.youtube_url != blank %}
          <a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener" aria-label="YouTube">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="5.5" width="20" height="13" rx="3.5"/><path class="crosley-footer__social-dot" d="M10.5 9.5 15 12l-4.5 2.5v-5Z"/></svg>
          </a>
        {% endif %}
      </div>
    </div>

    {% for block in section.blocks %}
      {% liquid
        assign fallback_key = block.settings.heading | handleize
        case fallback_key
          when 'shop'
            assign fallback_links = 'Record Players::/collections/record-players|Speakers::/collections/speakers|Radios::/collections/radios|CD Players::/collections/cd-players|Cassette Players::/collections/cassette-players|Media Stands::/collections/media-stands|More::/collections/all'
          when 'our-company'
            assign fallback_links = 'Crosley Brands::/pages/crosley-brands|Careers::/pages/careers|Accessibility::/pages/accessibility|Custom Cruiser Contest::/pages/custom-cruiser-contest|2025 Contest Winners::/pages/contest-winners|Ambassadors::/pages/ambassadors'
          when 'customer-care'
            assign fallback_links = 'Customer Service::/pages/customer-service|Contact Us::/pages/contact-us|Feedback::/pages/feedback|Replacement Needles::/pages/replacement-needles|Product Registration::/pages/product-registration|Order Status::/pages/order-status'
          when 'resources'
            assign fallback_links = 'FAQ::/pages/faq|Use & Care::/pages/use-and-care|Warranty::/pages/warranty|Shipping Policy::/policies/shipping-policy|Return Policy::/policies/refund-policy|International::/pages/international'
          else
            assign fallback_links = ''
        endcase
      %}
      <details class="crosley-footer__menu" data-footer-menu open {{ block.shopify_attributes }}>
        <summary>
          <span>{{ block.settings.heading | escape }}</span>
          <span class="svg-wrapper crosley-footer__menu-caret" aria-hidden="true">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
        </summary>
        {% if block.settings.menu != blank %}
          <nav aria-label="{{ block.settings.heading | escape }}">
            {% for link in block.settings.menu.links %}
              <a href="{{ link.url }}">{{ link.title | escape }}</a>
            {% endfor %}
          </nav>
        {% elsif fallback_links != blank %}
          <nav aria-label="{{ block.settings.heading | escape }}">
            {% assign fallback_items = fallback_links | split: '|' %}
            {% for item in fallback_items %}
              {% assign parts = item | split: '::' %}
              <a href="{{ parts[1] }}">{{ parts[0] | escape }}</a>
            {% endfor %}
          </nav>
        {% endif %}
      </details>
    {% endfor %}

    <div class="crosley-footer__bottom">
      <div class="crosley-footer__localization">
        {% if localization.available_countries.size > 1 %}
          {% form 'localization', id: 'FooterCountryForm', class: 'crosley-footer__country-form' %}
            <label class="visually-hidden" for="FooterCountry-{{ section.id }}">Country and currency</label>
            <select id="FooterCountry-{{ section.id }}" name="country_code" onchange="this.form.submit()">
              {% for country in localization.available_countries %}
                <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                  {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                </option>
              {% endfor %}
            </select>
          {% endform %}
        {% else %}
          <span>{{ localization.country.name }} ({{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }})</span>
        {% endif %}
      </div>

      <p class="crosley-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_name | default: shop.name | escape }}{% if section.settings.show_powered_by %}. Powered by Shopify{% endif %}
      </p>

      {% if shop.enabled_payment_types.size > 0 %}
        <ul class="crosley-footer__payments" role="list" aria-label="Payment methods">
          {% for type in shop.enabled_payment_types %}
            <li>{{ type | payment_type_svg_tag: class: 'crosley-footer__payment-icon' }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
</footer>

{% stylesheet %}
  .crosley-footer {
    padding: var(--crosley-section-space) var(--crosley-page-gutter) 0;
    color: #171f26;
    background: #ffffff;
  }

  .crosley-footer__inner {
    display: grid;
    width: 100%;
    max-width: 1400px;
    grid-template-columns: minmax(220px, 1.45fr) repeat(4, minmax(110px, 0.75fr));
    gap: clamp(24px, 3.33vw, 48px);
    margin-inline: auto;
  }

  .crosley-footer__newsletter-heading {
    margin: 0 0 20px;
    color: #383637;
    font-size: clamp(16px, calc(14.98px + 0.2614vw), 20px);
    font-weight: 700;
    letter-spacing: 0.025em;
    text-transform: uppercase;
  }

  .crosley-footer summary {
    margin: 0 0 24px;
    color: #383637;
    font-size: clamp(14px, calc(13.49px + 0.1307vw), 16px);
    font-weight: 700;
    letter-spacing: 0.025em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .crosley-footer__newsletter > p {
    max-width: 34ch;
    margin: 0 0 20px;
    color: #676767;
    font-size: clamp(11px, calc(10.49px + 0.1307vw), 13px);
    line-height: 1.6;
  }

  .crosley-footer__form {
    display: grid;
    gap: 14px;
    max-width: 300px;
  }

  .crosley-footer__form input {
    width: 100%;
    height: 48px;
    padding-inline: 16px;
    color: #171f26;
    background: #ffffff;
    border: 1px solid #dadada;
  }

  .crosley-footer__form button {
    width: max-content;
    min-height: 46px;
    padding-inline: 32px;
    color: #ffffff;
    background: #383637;
    border: 0;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .crosley-footer__form-message {
    grid-column: 1 / -1;
    margin: 0;
    color: #676767;
    font-size: 12px;
    line-height: 1.4;
  }

  .crosley-footer__social {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-block-start: 28px;
  }

  .crosley-footer__social a {
    display: inline-flex;
    width: 18px;
    height: 18px;
    align-items: center;
    justify-content: center;
    color: #676767;
    text-decoration: none;
  }

  .crosley-footer__social svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 1.6;
  }

  .crosley-footer__social svg path {
    stroke: none;
  }

  .crosley-footer__social svg rect,
  .crosley-footer__social svg circle:not(.crosley-footer__social-dot) {
    fill: none;
  }

  .crosley-footer__social-dot {
    fill: currentColor;
    stroke: none;
  }

  .crosley-footer__menu nav a {
    color: #676767;
    text-decoration: none;
    font-size: clamp(12px, calc(11.235px + 0.1961vw), 15px);
    line-height: 1.25;
  }

  .crosley-footer__social a:hover,
  .crosley-footer__menu nav a:hover {
    color: #171f26;
    text-decoration: underline;
  }

  .crosley-footer__menu summary {
    list-style: none;
    cursor: default;
  }

  .crosley-footer__menu summary::-webkit-details-marker {
    display: none;
  }

  .crosley-footer__menu-caret {
    display: none;
  }

  .crosley-footer__menu nav {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .crosley-footer__bottom {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    margin-block-start: 64px;
    padding-block: 28px;
    border-top: 1px solid #ededed;
    color: #676767;
    font-size: clamp(11px, calc(10.49px + 0.1307vw), 13px);
  }

  .crosley-footer__country-form select {
    max-width: 100%;
    padding: 4px 22px 4px 0;
    color: #676767;
    background: transparent;
    border: 0;
    font: inherit;
    cursor: pointer;
  }

  .crosley-footer__copyright {
    margin: 0;
    letter-spacing: 0.02em;
    text-align: center;
    text-transform: uppercase;
  }

  .crosley-footer__payments {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .crosley-footer__payments li {
    display: flex;
  }

  .crosley-footer__payment-icon {
    width: 38px;
    height: 24px;
  }

  @media (max-width: 860px) {
    .crosley-footer {
      padding: 48px var(--crosley-page-gutter) 0;
    }

    .crosley-footer__inner {
      display: block;
    }

    .crosley-footer__newsletter {
      max-width: 440px;
      margin-block-end: 32px;
    }

    .crosley-footer__menu {
      border-bottom: 1px solid #ededed;
    }

    .crosley-footer__menu summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin: 0;
      padding: 18px 2px 18px 0;
      cursor: pointer;
    }

    .crosley-footer__menu-caret {
      display: inline-flex;
      width: 14px;
      height: 14px;
      flex: 0 0 14px;
      transition: transform 180ms ease;
    }

    .crosley-footer__menu-caret svg {
      width: 100%;
      height: 100%;
    }

    .crosley-footer__menu[open] .crosley-footer__menu-caret {
      transform: rotate(180deg);
    }

    .crosley-footer__menu nav {
      padding-block-end: 20px;
    }

    .crosley-footer__bottom {
      display: flex;
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
      margin-block-start: 24px;
      padding-block: 20px 28px;
    }

    .crosley-footer__copyright {
      text-align: start;
    }

    .crosley-footer__payments {
      justify-content: flex-start;
    }
  }

  @media (max-width: 480px) {
    .crosley-footer__form {
      grid-template-columns: minmax(0, 1fr) auto;
      max-width: none;
      gap: 0;
    }

    .crosley-footer__form input,
    .crosley-footer__form button {
      height: 44px;
      min-height: 44px;
    }

    .crosley-footer__form button {
      padding-inline: 20px;
      font-size: 12px;
    }
  }
{% endstylesheet %}

{% javascript %}
  function initializeCrosleyFooter(section) {
    if (section.dataset.footerInitialized === 'true') return;
    section.dataset.footerInitialized = 'true';

    const menus = Array.from(section.querySelectorAll('[data-footer-menu]'));
    const compactQuery = window.matchMedia('(max-width: 860px)');
    const syncMenus = () => {
      menus.forEach((menu) => {
        if (compactQuery.matches) {
          menu.removeAttribute('open');
        } else {
          menu.setAttribute('open', '');
        }
      });
    };

    compactQuery.addEventListener('change', syncMenus);
    syncMenus();
  }

  document.querySelectorAll('.crosley-footer').forEach(initializeCrosleyFooter);
  document.addEventListener('shopify:section:load', (event) => {
    const footer = event.target.matches('.crosley-footer')
      ? event.target
      : event.target.querySelector('.crosley-footer');
    if (footer) initializeCrosleyFooter(footer);
  });
{% endjavascript %}

{% schema %}
{
  "name": "Crosley footer",
  "tag": "section",
  "class": "crosley-footer-section",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "header", "content": "Newsletter" },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Newsletter" },
    {
      "type": "select",
      "id": "newsletter_heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    { "type": "text", "id": "newsletter_text", "label": "Newsletter text", "default": "Subscribe to receive updates, access to exclusive deals, and more." },
    { "type": "header", "content": "Social links" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" },
    { "type": "url", "id": "twitter_url", "label": "X URL" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "youtube_url", "label": "YouTube URL" },
    { "type": "header", "content": "Bottom bar" },
    { "type": "text", "id": "copyright_name", "label": "Copyright name", "default": "Crosley Radio" },
    { "type": "checkbox", "id": "show_powered_by", "label": "Show Powered by Shopify", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "header", "content": "Menu" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Crosley footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Our company" } },
        { "type": "menu", "settings": { "heading": "Customer care" } },
        { "type": "menu", "settings": { "heading": "Resources" } }
      ]
    }
  ]
}
{% endschema %}
