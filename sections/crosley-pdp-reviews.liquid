{% comment %}
  Review app host with an accessible empty state when no app block is configured.
  @example
  Add the merchant's review app block inside this section in the theme editor.
{% endcomment %}

{% assign heading_tag = section.settings.heading_tag | default: 'h2' %}

{% liquid
  assign review_target = section.settings.review_link
  if review_target == blank
    assign review_target = '#CrosleyPdpReviews-' | append: section.id
  endif
%}

<section class="crosley-pdp-reviews" id="CrosleyPdpReviews">
  <div class="crosley-pdp-reviews__inner">
    <{{ heading_tag }} class="crosley-pdp-reviews__heading">{{ section.settings.heading | escape }}</{{ heading_tag }}>
    {% if section.blocks.size > 0 %}
      <div class="crosley-pdp-reviews__app">
        {% content_for 'blocks' %}
      </div>
    {% else %}
      <div class="crosley-pdp-reviews__empty">
        <div class="crosley-pdp-reviews__provider" aria-label="Authentic Reviews">
          <span aria-hidden="true">b</span>
          <span class="crosley-pdp-reviews__provider-name">Authentic<br>Reviews</span>
        </div>
        <p class="crosley-pdp-reviews__prompt">{{ section.settings.review_label | escape }}</p>
        <div class="crosley-pdp-reviews__stars" aria-label="Choose a rating">
          {% for rating in (1..5) %}
            <button type="button" aria-label="{{ rating }} star{% unless rating == 1 %}s{% endunless %}">
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M10 1.5 12.6 7.1l6.1.7-4.6 4.1 1.3 6.1-5.4-3.2L4.6 18l1.3-6.1-4.6-4.1 6.1-.7L10 1.5Z" />
              </svg>
            </button>
          {% endfor %}
        </div>
        <p class="crosley-pdp-reviews__message">{{ section.settings.empty_text | escape }}</p>
        <a class="crosley-pdp-reviews__action" href="{{ review_target }}">{{ section.settings.review_label | escape }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .crosley-pdp-reviews {
    width: 100%;
    padding: 32px clamp(16px, calc(9.88px + 1.5686vw), 40px) 20px;
    background: #fff;
  }

  .crosley-pdp-reviews__inner {
    width: 100%;
    max-width: none;
    margin-inline: auto;
    padding: 40px;
    border: 1px solid #ededed;
  }

  .crosley-pdp-reviews__heading {
    margin: 0 0 20px;
    color: #171f26;
    font-size: clamp(20px, calc(17.96px + 0.5229vw), 28px);
    font-weight: 700;
    line-height: normal;
    letter-spacing: 0.02em;
    text-align: left;
    text-transform: uppercase;
  }

  .crosley-pdp-reviews__empty {
    text-align: left;
  }

  .crosley-pdp-reviews__provider {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-block-end: 32px;
    padding: 6px 12px 6px 6px;
    border: 1px solid #ededed;
    color: #676767;
    font-size: clamp(11px, calc(10.49px + 0.1307vw), 13px);
    line-height: 1.3;
  }

  .crosley-pdp-reviews__provider > span:first-child {
    display: grid;
    width: 26px;
    height: 26px;
    place-items: center;
    border-radius: 50%;
    color: #fff;
    background: #171f26;
    font-size: 14px;
    font-weight: 700;
  }

  .crosley-pdp-reviews__provider-name {
    color: #676767;
    font-weight: 400;
  }

  .crosley-pdp-reviews__prompt {
    margin: 0 0 14px;
    color: #676767;
    font-size: clamp(12px, calc(11.235px + 0.1961vw), 15px);
    line-height: normal;
  }

  .crosley-pdp-reviews__stars {
    display: flex;
    gap: 10px;
    margin-block-end: 28px;
  }

  .crosley-pdp-reviews__stars button {
    display: grid;
    width: 56px;
    height: 56px;
    padding: 0;
    place-items: center;
    border: 1px solid #dadada;
    color: #a6a6a6;
    background: #fff;
    cursor: pointer;
  }

  .crosley-pdp-reviews__stars svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
  }

  .crosley-pdp-reviews__stars button:hover,
  .crosley-pdp-reviews__stars button:focus-visible {
    color: #171f26;
    border-color: #171f26;
  }

  .crosley-pdp-reviews__message {
    margin: 0;
    color: #171f26;
    font-size: clamp(14px, calc(13.49px + 0.1307vw), 16px);
    font-weight: 700;
  }

  .crosley-pdp-reviews__action {
    display: none;
    color: #171f26;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
  }

  @media (max-width: 860px) {
    .crosley-pdp-reviews {
      padding: 32px 20px 48px;
    }

    .crosley-pdp-reviews__inner {
      padding: 40px;
      border: 1px solid #ededed;
    }

    .crosley-pdp-reviews__heading {
      margin-block-end: 20px;
      font-size: 20px;
      text-align: left;
    }

    .crosley-pdp-reviews__empty {
      display: block;
      min-height: 0;
      padding: 0;
      text-align: left;
    }

    .crosley-pdp-reviews__provider {
      font-size: 11px;
    }

    .crosley-pdp-reviews__provider > span:first-child {
      width: 26px;
      height: 26px;
      font-size: 14px;
    }

    .crosley-pdp-reviews__prompt {
      display: block;
      margin: 0 0 14px;
      font-size: 12px;
    }

    .crosley-pdp-reviews__stars {
      gap: 10px;
    }

    .crosley-pdp-reviews__stars button {
      width: calc((100% - 40px) / 5);
      height: 56px;
      border: 1px solid #dadada;
    }

    .crosley-pdp-reviews__message {
      margin-block-start: 0;
      color: #171f26;
      font-size: 14px;
      font-weight: 700;
    }

    .crosley-pdp-reviews__action {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Crosley PDP reviews",
  "tag": "section",
  "class": "crosley-pdp-section crosley-pdp-section--reviews",
  "disabled_on": { "groups": ["header", "footer"] },
  "blocks": [{ "type": "@app" }],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reviews" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    { "type": "text", "id": "empty_text", "label": "Empty state", "default": "Be the first to review this product" },
    { "type": "text", "id": "review_label", "label": "Review link label", "default": "Review this Product" },
    { "type": "url", "id": "review_link", "label": "Review link" }
  ],
  "presets": [{ "name": "Crosley PDP reviews" }]
}
{% endschema %}
