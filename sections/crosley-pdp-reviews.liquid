{% comment %}
  Review app host with an accessible empty state when no app block is configured.
  @example
  Add the merchant's review app block inside this section in the theme editor.
{% endcomment %}

{% liquid
  assign review_target = section.settings.review_link
  if review_target == blank
    assign review_target = '#CrosleyPdpReviews-' | append: section.id
  endif
%}

<section class="crosley-pdp-reviews" id="CrosleyPdpReviews">
  <div class="crosley-pdp-reviews__inner">
    <h2>{{ section.settings.heading | escape }}</h2>
    {% if section.blocks.size > 0 %}
      <div class="crosley-pdp-reviews__app">
        {% content_for 'blocks' %}
      </div>
    {% else %}
      <div class="crosley-pdp-reviews__empty">
        <div class="crosley-pdp-reviews__provider" aria-label="Authentic Reviews">
          <span aria-hidden="true">b</span>
          <strong>Authentic<br>Reviews</strong>
        </div>
        <p class="crosley-pdp-reviews__prompt">{{ section.settings.review_label | escape }}</p>
        <div class="crosley-pdp-reviews__stars" aria-label="Choose a rating">
          {% for rating in (1..5) %}
            <button type="button" aria-label="{{ rating }} star{% unless rating == 1 %}s{% endunless %}">&#9734;</button>
          {% endfor %}
        </div>
        <p class="crosley-pdp-reviews__message">{{ section.settings.empty_text | escape }}</p>
        <a class="crosley-pdp-reviews__action" href="{{ review_target }}">{{ section.settings.review_label | escape }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .crosley-pdp-reviews {
    width: 100%;
    padding: 30px 36px 64px;
    background: #fff;
  }

  .crosley-pdp-reviews__inner {
    width: 100%;
    max-width: 1750px;
    min-height: 436px;
    margin-inline: auto;
    padding: 54px 50px 48px;
    border: 1px solid #ededed;
  }

  .crosley-pdp-reviews h2 {
    margin: 0 0 26px;
    color: #171f26;
    font-size: 30px;
    font-weight: 700;
    line-height: 1.1;
    text-align: left;
    text-transform: uppercase;
  }

  .crosley-pdp-reviews__empty {
    text-align: left;
  }

  .crosley-pdp-reviews__provider {
    display: inline-flex;
    min-width: 120px;
    min-height: 58px;
    align-items: center;
    gap: 12px;
    padding: 10px 8px;
    border: 1px solid #ededed;
    color: #171f26;
    font-size: 12px;
    line-height: 1.15;
  }

  .crosley-pdp-reviews__provider > span {
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border-radius: 50%;
    color: #fff;
    background: #171f26;
    font-size: 16px;
    font-weight: 700;
  }

  .crosley-pdp-reviews__prompt {
    margin: 40px 0 18px;
    color: #4f4f4f;
    font-size: 16px;
    line-height: 1.2;
  }

  .crosley-pdp-reviews__stars {
    display: flex;
    gap: 12px;
  }

  .crosley-pdp-reviews__stars button {
    display: grid;
    width: 70px;
    height: 70px;
    padding: 0;
    place-items: center;
    border: 1px solid #dedede;
    color: #a6a6a6;
    background: #fff;
    font: inherit;
    font-size: 32px;
    line-height: 1;
    cursor: pointer;
  }

  .crosley-pdp-reviews__stars button:hover,
  .crosley-pdp-reviews__stars button:focus-visible {
    color: #171f26;
    border-color: #171f26;
  }

  .crosley-pdp-reviews__message {
    margin: 38px 0 0;
    color: #171f26;
    font-size: 16px;
    font-weight: 700;
  }

  .crosley-pdp-reviews__action {
    display: none;
    color: #171f26;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
  }

  @media (max-width: 860px) {
    .crosley-pdp-reviews {
      padding: 32px 20px 48px;
    }

    .crosley-pdp-reviews__inner {
      min-height: 0;
      padding: 40px;
      border: 1px solid #ededed;
    }

    .crosley-pdp-reviews h2 {
      margin-block-end: 20px;
      font-size: 20px;
      text-align: left;
    }

    .crosley-pdp-reviews__empty {
      display: block;
      min-height: 0;
      padding: 0;
      text-align: left;
    }

    .crosley-pdp-reviews__provider {
      display: inline-flex;
      min-width: 92px;
      min-height: 43px;
      gap: 10px;
      padding: 6px 12px 6px 6px;
      font-size: 11px;
    }

    .crosley-pdp-reviews__provider > span {
      width: 26px;
      height: 26px;
      font-size: 14px;
    }

    .crosley-pdp-reviews__prompt {
      display: block;
      margin: 32px 0 14px;
      font-size: 12px;
    }

    .crosley-pdp-reviews__stars {
      gap: 10px;
    }

    .crosley-pdp-reviews__stars button {
      width: calc((100% - 40px) / 5);
      height: 56px;
      border: 1px solid #dadada;
      font-size: 24px;
    }

    .crosley-pdp-reviews__message {
      margin-block-start: 28px;
      color: #171f26;
      font-size: 14px;
      font-weight: 700;
    }

    .crosley-pdp-reviews__action {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Crosley PDP reviews",
  "tag": "section",
  "class": "crosley-pdp-section crosley-pdp-section--reviews",
  "disabled_on": { "groups": ["header", "footer"] },
  "blocks": [{ "type": "@app" }],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reviews" },
    { "type": "text", "id": "empty_text", "label": "Empty state", "default": "Be the first to review this product." },
    { "type": "text", "id": "review_label", "label": "Review link label", "default": "Review this product" },
    { "type": "url", "id": "review_link", "label": "Review link" }
  ],
  "presets": [{ "name": "Crosley PDP reviews" }]
}
{% endschema %}
