{% liquid
  assign product = section.settings.product | default: collection.products.first
  assign product_image = product.featured_media.preview_image
  assign product_alt = product_image.alt | default: product.title
  assign product_description = product.description | strip_html | truncate: 260
  assign product_sku = product.selected_or_first_available_variant.sku
%}

{% if product != blank %}
  <section class="crosley-product-week" data-testid="crosley-product-of-the-week-{{ section.id }}">
    <div class="crosley-product-week__inner">
      {% if section.settings.eyebrow != blank %}
        <p class="crosley-product-week__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading | escape }}</h2>
      {% endif %}

      <div class="crosley-product-week__grid">
        <div class="crosley-product-week__media">
          {% if product_image != blank %}
            {{
              product_image
              | image_url: width: 1400
              | image_tag:
                widths: '500, 700, 900, 1200, 1400',
                sizes: '(min-width: 750px) 50vw, 100vw',
                loading: 'lazy',
                alt: product_alt
            }}
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'crosley-product-week__placeholder' }}
          {% endif %}
        </div>

        <div class="crosley-product-week__content">
          {% if section.settings.badge != blank %}
            <p class="crosley-product-week__badge">{{ section.settings.badge | escape }}</p>
          {% endif %}

          <h3>{{ product.title | escape }}</h3>

          {% if product_sku != blank %}
            <p class="crosley-product-week__sku">Model Number {{ product_sku | escape }}</p>
          {% endif %}

          <p class="crosley-product-week__price">{{ product.price | money }}</p>
          <div class="crosley-product-week__rule"></div>

          {% if product_description != blank %}
            <p class="crosley-product-week__description">{{ product_description | escape }}</p>
          {% endif %}

          {% if section.settings.button_label != blank %}
            <a class="crosley-product-week__button" href="{{ product.url }}">
              {{ section.settings.button_label | escape }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .crosley-product-week {
    padding: clamp(40px, calc(37.45px + 0.6536vw), 50px)
      clamp(16px, calc(7.33px + 2.2222vw), 50px)
      clamp(40px, calc(29.29px + 2.7451vw), 82px);
    color: #171f26;
    background: #fff;
  }

  .crosley-product-week__inner {
    width: min(100%, 1600px);
    margin-inline: auto;
  }

  .crosley-product-week__eyebrow {
    margin: 0 0 20px;
    color: #676767;
    font-size: clamp(12px, calc(11.235px + 0.1961vw), 15px);
    font-weight: 700;
    letter-spacing: 0.03em;
    text-align: center;
    text-transform: uppercase;
  }

  .crosley-product-week h2 {
    margin: 0 0 64px;
    color: #171f26;
    font-size: clamp(24px, calc(21.96px + 0.5229vw), 32px);
    letter-spacing: 0.02em;
    text-align: center;
    text-transform: uppercase;
  }

  .crosley-product-week__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 64px;
    align-items: start;
  }

  .crosley-product-week__media {
    display: grid;
    height: 369px;
    min-width: 0;
    place-items: center;
    overflow: hidden;
    background: #f5f5f4;
  }

  .crosley-product-week__media img,
  .crosley-product-week__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    object-fit: contain;
  }

  .crosley-product-week__content {
    max-width: 460px;
    padding-top: 2px;
  }

  .crosley-product-week__badge {
    margin: 0 0 14px;
    color: #676767;
    font-size: clamp(11px, calc(10.49px + 0.1307vw), 13px);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .crosley-product-week h3 {
    margin: 0 0 12px;
    color: #171f26;
    font-size: clamp(18px, calc(16.47px + 0.3922vw), 24px);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .crosley-product-week__sku {
    margin: 0 0 12px;
    color: #171f26;
    font-size: 14px;
  }

  .crosley-product-week__price {
    margin: 0 0 28px;
    color: #676767;
    font-size: clamp(16px, calc(14.98px + 0.2614vw), 20px);
    font-weight: 700;
  }

  .crosley-product-week__rule {
    margin-bottom: 28px;
    border-top: 1px solid #ededed;
  }

  .crosley-product-week__description {
    margin: 0 0 28px;
    color: #171f26;
    font-size: clamp(14px, calc(13.49px + 0.1307vw), 16px);
    line-height: 1.6;
  }

  .crosley-product-week__button {
    display: block;
    padding: 18px;
    color: #fff;
    background: #383637;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }

  .crosley-product-week__button:hover {
    background: #171f26;
  }

  @media screen and (max-width: 749px) {
    .crosley-product-week h2 {
      margin-bottom: 28px;
    }

    .crosley-product-week__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }

    .crosley-product-week__media {
      height: auto;
      aspect-ratio: 16 / 11;
    }

    .crosley-product-week__content {
      max-width: none;
    }

    .crosley-product-week__description {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
    }

    .crosley-product-week__button {
      padding: 13px 20px;
      font-size: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product of the week",
  "tag": "section",
  "class": "crosley-home-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Selection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product Of The Week"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Product badge",
      "default": "New"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Buy Now"
    }
  ],
  "presets": [
    {
      "name": "Product of the week"
    }
  ]
}
{% endschema %}
