{% liquid
  assign main_collection = section.settings.main_collection
  assign side_collection_one = section.settings.side_collection_one
  assign side_collection_two = section.settings.side_collection_two
  assign main_image = section.settings.main_image | default: main_collection.featured_image
  assign side_image_one = section.settings.side_image_one | default: side_collection_one.featured_image
  assign side_image_two = section.settings.side_image_two | default: side_collection_two.featured_image
%}

<section class="crosley-gift-mosaic">
  <a class="crosley-gift-mosaic__main" href="{{ section.settings.main_link | default: main_collection.url }}">
    {% if main_image != blank %}
      {{ main_image | image_url: width: 2200 | image_tag: widths: '750, 1100, 1600, 2200', sizes: '(min-width: 750px) 66vw, 100vw', loading: 'lazy' }}
    {% else %}
      <img src="{{ 'crosley-gift-guide.jpg' | asset_url }}" alt="{{ section.settings.heading | escape }}" width="1600" height="900" loading="lazy">
    {% endif %}
    <span class="crosley-gift-mosaic__shade"></span>
    <span class="crosley-gift-mosaic__content">
      <strong>{{ section.settings.heading | escape }}</strong>
      <span>{{ section.settings.text }}</span>
      <u>{{ section.settings.link_label | escape }}</u>
    </span>
  </a>

  <div class="crosley-gift-mosaic__side">
    <a href="{{ side_collection_one.url }}" aria-label="{{ side_collection_one.title | default: 'Shop collection' | escape }}">
      {% if side_image_one != blank %}
        {{ side_image_one | image_url: width: 1200 | image_tag: widths: '500, 800, 1200', sizes: '(min-width: 750px) 34vw, 100vw', loading: 'lazy' }}
      {% else %}
        {{ 'crosley-audioengine.webp' | asset_url | image_tag: alt: 'Shop speakers', loading: 'lazy' }}
      {% endif %}
    </a>
    <a href="{{ side_collection_two.url }}" aria-label="{{ side_collection_two.title | default: 'Shop collection' | escape }}">
      {% if side_image_two != blank %}
        {{ side_image_two | image_url: width: 1200 | image_tag: widths: '500, 800, 1200', sizes: '(min-width: 750px) 34vw, 100vw', loading: 'lazy' }}
      {% else %}
        {{ 'crosley-c65-promo.webp' | asset_url | image_tag: alt: 'Shop media stands', loading: 'lazy' }}
      {% endif %}
    </a>
  </div>
</section>

{% stylesheet %}
  .crosley-gift-mosaic {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 4px;
    padding: 50px 50px 82px;
    background: #ffffff;
  }

  .crosley-gift-mosaic a {
    position: relative;
    display: block;
    min-width: 0;
    overflow: hidden;
    color: #ffffff;
    text-decoration: none;
  }

  .crosley-gift-mosaic__main {
    height: 388px;
  }

  .crosley-gift-mosaic img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .crosley-gift-mosaic a:hover img {
    transform: scale(1.02);
  }

  .crosley-gift-mosaic__shade {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 34%);
  }

  .crosley-gift-mosaic__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 32px;
    text-align: center;
  }

  .crosley-gift-mosaic__content strong {
    max-width: 24ch;
    font-size: clamp(1.25rem, 2.1vw, 1.75rem);
    letter-spacing: 0.025em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .crosley-gift-mosaic__content > span {
    max-width: 42ch;
    margin-block-start: 16px;
    color: rgb(255 255 255 / 85%);
  }

  .crosley-gift-mosaic__content u {
    margin-block-start: 18px;
    font-size: 0.88rem;
    font-weight: 400;
    text-transform: uppercase;
  }

  .crosley-gift-mosaic__side {
    display: grid;
    height: 388px;
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 4px;
  }

  @media (max-width: 749px) {
    .crosley-gift-mosaic {
      grid-template-columns: 1fr;
      padding: 20px 20px 52px;
    }

    .crosley-gift-mosaic__main {
      height: 440px;
    }

    .crosley-gift-mosaic__side {
      height: auto;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
    }

    .crosley-gift-mosaic__side a {
      aspect-ratio: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .crosley-gift-mosaic img {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Crosley gift mosaic",
  "tag": "section",
  "class": "crosley-home-section",
  "settings": [
    { "type": "image_picker", "id": "main_image", "label": "Main image" },
    { "type": "collection", "id": "main_collection", "label": "Main collection" },
    { "type": "url", "id": "main_link", "label": "Main link override" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Need a gift for the music fan in your life?" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Crosley has a turntable for everyone. Find the right gift with our handy guide.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read the gift guide" },
    { "type": "image_picker", "id": "side_image_one", "label": "Top side image" },
    { "type": "collection", "id": "side_collection_one", "label": "Top side collection" },
    { "type": "image_picker", "id": "side_image_two", "label": "Bottom side image" },
    { "type": "collection", "id": "side_collection_two", "label": "Bottom side collection" }
  ],
  "presets": [{ "name": "Crosley gift mosaic" }]
}
{% endschema %}
